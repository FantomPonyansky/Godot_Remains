static func _strip_lib_prefix(lib: String) -> String:
	## Strip directory prefix from library_item (e.g., "wing/rwing" -> "rwing").
	var slash := lib.rfind("/")
	return lib.substr(slash + 1) if slash >= 0 else lib


func _get_sprite_for_nested(entry: Dictionary) -> Sprite2D:
	## The primary Sprite2D for a nested entry (first element sprite or leaf node).
	if entry.get("is_container", false):
		var sprites := _container_artwork_sprites(entry["node"])
		return sprites[0] if not sprites.is_empty() else null
	return entry["node"]


func _get_all_sprites_for_nested(entry: Dictionary) -> Array[Sprite2D]:
	## ALL Sprite2Ds for a nested entry (all element sprites or leaf node).
	if entry.get("is_container", false):
		return _container_artwork_sprites(entry["node"])
	var result: Array[Sprite2D] = []
	result.append(entry["node"])
	return result


func _get_lib_raster_scale(lib_name: String) -> float:
	## Rasterization scale R of a library (index.json precomputed.library_scales,
	## the value 04.3 rasterized at; Sprite2D.scale = 1/R).
	var scales: Dictionary = _index.get("precomputed", {}).get("library_scales", {})
	if not scales.has(lib_name):
		push_error("rig_base: no library_scales entry for '%s'" % lib_name)
		return 1.0
	return float(scales[lib_name])


func _swap_bone_lib(bone_name: String, lib_name: String) -> void:
	## Swap a bone's library (animation method tracks: mid-animation texture switching).
	var current: String = _bone_lib.get(bone_name, "")
	if current == lib_name:
		return

	var old_key := _strip_lib_prefix(current)
	var new_key := _strip_lib_prefix(lib_name)
	_bone_lib[bone_name] = lib_name
	# The frame the bone node was sent to belonged to the old library.
	var bone_node: Node = _bones.get(bone_name)
	if bone_node != null:
		_child_frames.erase(bone_node)
		_graphic_shown.erase(bone_node)

	# The new library's frame: its variant label frame, else the frame its
	# running index ticker / held frame shows, else the subclass rule — one
	# frame for the nested children AND the artwork (Flash: one clip, one
	# playhead; a swapped-in ticker clip is already on its playing frame).
	var current_frame := _lib_current_frame(new_key)

	# Show/hide nested children: hide old library's, show new library's
	for entry: Dictionary in _nested:
		if entry["bone_name"] != bone_name:
			continue
		var vis_lib: String = entry["vis_lib"]
		if vis_lib == old_key:
			entry["node"].visible = false
		elif vis_lib == new_key:
			_show_child_entry(entry, current_frame)
	_rig_on_bone_lib_swapped(bone_name, new_key)

	# Swap per-element sprite textures and update scale for new library
	var entries: Array = _bone_element_sprites.get(bone_name, [])
	if entries.is_empty():
		return
	var new_r: float = _get_lib_raster_scale(new_key)
	var new_inv: float = 1.0 / new_r
	var frame_idx := str(current_frame)
	for entry: Dictionary in entries:
		# Only the bone's own artwork switches library: the artwork sprites of
		# the nested containers it holds (roll1 -> roller_pups2) belong to
		# their own symbols and are shown by the nested-children pass above.
		if _strip_lib_prefix(str(entry["lib"])) != old_key:
			continue
		entry["lib"] = new_key
		entry["sprite"].scale = Vector2(new_inv, new_inv)
		var elem_svgs := _get_element_svgs(new_key, entry["layer_index"])
		if elem_svgs.is_empty():
			entry["sprite"].texture = null
			continue
		var elem_list: Array = elem_svgs.get(frame_idx, [])
		if elem_list.is_empty():
			elem_list = elem_svgs.get("0", [])
		var si: int = entry["element_index"]
		if si < elem_list.size():
			_apply_texture(entry["sprite"], str(elem_list[si]).replace(".svg", ""))
			entry["sprite"].visible = true
		else:
			entry["sprite"].texture = null
			entry["sprite"].visible = false


func refresh_visuals(restart: bool = false) -> void:
	## Flash refreshVis(): re-instantiating the body re-runs every frame
	## script. Here: re-apply every runtime state, then
	##   restart = false (the default, galleries and tests): keep the playhead —
	##     the current animation is re-entered at its position;
	##   restart = true (R3 #9, Step 16.1; UnitPlayer.refreshVis): Flash's
	##     `osn.gotoAndStop('nope'); osn.gotoAndStop(dez)` (UnitPlayer.as:3064-
	##     3068) — a fresh body instance of the osn label `dez` that plays from
	##     its frame 1, every nested clip reset (a new instance) and the eye on
	##     its frame 1 (state 0). A walk at frame k restarts at walk_start
	##     frame 0; without an osn label the playhead is kept.
	## The driver applies the new armour first (set_armor), as the frame
	## scripts of the new body read it through Obj.setArmor.
	_rig_refresh_variant()
	_apply_blend_modes()
	if restart:
		var label := get_osn_label()
		var state_anim := ""
		for state: Dictionary in _animation_states:
			if str(state["label"]) == label:
				state_anim = str(state.get("animation", ""))
				break
		if state_anim != "" and _anim_player.has_animation(state_anim):
			set_eye_state(0)
			_current_source = ""          # a new body instance: nested clips reset
			_current_bone_order = ""
			_current_state = label
			_start_anim(state_anim, 0, false)
			return
	var anim_name := get_current_anim()
	if anim_name != "":
		var was_playing := _anim_player.is_playing()
		var pos := _anim_player.current_animation_position
		_current_bone_order = ""
		_apply_anim_entry(anim_name)
		_anim_player.seek(pos, true)
		_fire_method_keys_up_to(anim_name, pos)
		if not was_playing:
			_anim_player.pause()
		_update_graphic_frames()


# =============================================================================
# Root transforms and attachments
# =============================================================================

func set_stealth(enabled: bool) -> void:
	## Stealth mode (Flash `vis.alpha = 0.5`): the CanvasGroup body composites
	## all bones first, so overlapping bones do not show through each other
	## at half alpha. self_modulate, not modulate: modulate propagates into
	## the children's vertex colour AND scales the group's composite, i.e.
	## alpha squared.
	if _pre_ready(set_stealth.bind(enabled)): return
	_stealth_a = 0.5 if enabled else 1.0
	_sync_root_alpha()


func set_rig_alpha(alpha: float) -> void:
	## Flash `vis.alpha` (the whole visual incl. attachments).
	modulate.a = alpha
	_sync_root_alpha()


## VisBase.set_alpha (`vis.alpha = a`): the root modulate, then the body composite (D26-070).
func set_alpha(a: float) -> void:
	modulate.a = a
	_sync_root_alpha()


func set_osn_alpha(alpha: float) -> void:
	## Flash `vis.osn.alpha`.
	if _pre_ready(set_osn_alpha.bind(alpha)): return
	if _osn:
		_osn.modulate.a = alpha
		_proxy_note("osn", "alpha", alpha)
	_sync_root_alpha()


## Step 26.5 (D26-070): the alpha of the rig root and of every node between it and `body` (the
## root's `modulate.a` = `vis.alpha`, osn's = `vis.osn.alpha`) is applied ONCE, to the body's
## composite, after its filters: Godot hands an ancestor's modulate to the children drawn into the
## CanvasGroup AND to the group's own draw, so the bones were faded before the filters and the
## composite faded again (alpha squared: emergence too faint, 19.1/19.4). The body's own modulate
## cancels the chain for its children (1 / chain alpha), and the composite carries the chain alpha
## on `self_modulate` together with stealth (0.5, the CanvasGroup's channel since 04 -- composed,
## never overwritten). The root attachments outside `body` keep the plain inherited alpha (they are
## not in the group). `modulate.a` stays the readable `vis.alpha` (units and verifiers read it).
## Called by the alpha setters and at every frame/tick start (a direct `modulate.a` write).
var _stealth_a := 1.0


func _sync_root_alpha() -> void:
	if not (_body is CanvasGroup):
		return
	var pa := 1.0
	var n: Node = _body.get_parent()
	while n != null:
		if n is CanvasItem:
			pa *= (n as CanvasItem).modulate.a
		if n == self:
			break
		n = n.get_parent()
	var inv := 1.0 / pa if pa > 1e-4 else 1.0
	var sm := (pa if pa > 1e-4 else 1.0) * _stealth_a
	if _body.modulate.a != inv:
		_body.modulate.a = inv
	if _body.self_modulate.a != sm:
		_body.self_modulate.a = sm


## The stealth half alpha (1 or 0.5) apart from the root alpha on the body composite.
func get_stealth_alpha() -> float:
	return _stealth_a


func set_osn_rotation(rad: float) -> void:
	## Flash `vis.osn.rotation`.
	if _pre_ready(set_osn_rotation.bind(rad)): return
	if _osn:
		_osn.rotation = rad
		_proxy_note("osn", "rotation", rad)


func set_osn_scale(sx: float, sy: float) -> void:
	## Flash `vis.osn.scaleX/scaleY` (UnitDron.as:50 1.5, UnitThunderTurret.as:23
	## 3, UnitFish.as:36 / UnitBat.as:31 `scaleX*1.2` (read get_osn_scale()),
	## UnitTransmitter.as:49 `scaleX = -1` (pass the current sy)): absolute
	## values. The mirror is the root (set_facing), not osn; the root
	## attachments stay unscaled siblings of osn.
	if _pre_ready(set_osn_scale.bind(sx, sy)): return
	if _osn:
		_osn.scale = Vector2(sx, sy)
		_proxy_note("osn", "scale", _osn.scale)


func get_osn_scale() -> Vector2:
	## Flash `vis.osn.scaleX/scaleY` (the read half of set_osn_scale).
	return _osn.scale if _osn else Vector2.ONE


func set_facing(storona: int) -> void:
	## Flash `vis.scaleX = storona` (Unit.as:1604): mirror the whole rig. A
	## direct `scale.x = storona` (Unit.setVisPos) reaches the same hook through
	## _check_facing (R3 #7) on the next frame or tick.
	var s := 1.0 if storona >= 0 else -1.0
	scale.x = absf(scale.x) * s
	_facing_seen = storona >= 0
	_rig_on_facing_changed(storona >= 0)


func get_attachment(att_name: String) -> Node2D:
	return _attachments.get(att_name)


func _set_attachment_visible(att_name: String, is_visible: bool) -> void:
	var node: Node2D = _attachments.get(att_name)
	if node:
		node.visible = is_visible


# =============================================================================
# Child clips — the driver contract for nested MovieClips (Steps 13/14)
#
# Flash drivers address nested clips by instance path under the visual:
# `vis.osn.puha.gotoAndStop(tr)`, `vis.osn.puha.puha.gotoAndPlay(2)`,
# `vis.osn.light.gotoAndStop(aiState+1)`, `vis.osn.t1.scaleX = storona`,
# `vis.osn.pole.visible = false`, `vis.dis.gotoAndStop(n)`, `vis.vzz.rotation`.
# A path here is the `.`-separated XFL instance names relative to `osn` (a
# leading `osn.` is accepted): first a bone (hierarchy instance name; the
# explicitly named one wins among duplicates) or a root attachment, then
# the nested instances (symbols/<lib>.json children[].instance; an unnamed
# child answers to its library name). The frame a child is sent to is its
# own symbol's frame: the keyframe artwork and the children it holds there
# (turel_puha frame n holds turel_puha<n>; dronDis2's 36 frames).
# =============================================================================

func get_child_node(path: String) -> Node2D:
	## The node a Flash instance path names, or null when it does not exist.
	var r := _resolve_child(_split_path(path))
	return r["node"] if not r.is_empty() else null


func child_goto(path: String, target: Variant, play: bool = false) -> bool:
	## Flash `<path>.gotoAndStop(n | 'label')` (`play` = gotoAndPlay(...)):
	## `target` is a 1-based frame number (clamped to the clip's length, as
	## Flash clamps) or a frame label of the child's own timeline. Returns
	## false when the path or the label does not exist (Flash throws; the
	## drivers catch).
	## R3 #1 (Step 16.1): gotoAndStop on the frame the child already shows
	## changes nothing but the playhead (Flash does not re-enter an unchanged
	## frame): the child stops if it was playing (its own ticker is dropped)
	## and returns true; its nested clips keep playing — UnitTurret.as:176
	## re-sends `puha.gotoAndStop(tr)` every tick while `puha.puha` plays its
	## muzzle flash 2→3→5.
	if _pre_ready(child_goto.bind(path, target, play)): return true
	var r := _resolve_child(_split_path(path))
	if r.is_empty():
		return false
	var frame := _child_frame_of(r["lib"], target)
	if frame < 0:
		return false
	if play:
		return _child_play_resolved(r, frame)
	_drop_dynamic_ticker(r["node"])
	if _shown_child_frame(r) == frame:
		# the node stops here: an index ticker no longer drives it either
		_child_frames[r["node"]] = frame
		return true
	_show_child_frame(r, frame)
	return true


func _shown_child_frame(r: Dictionary) -> int:
	## 0-based frame a resolved child shows now (get_child_frame - 1).
	if _child_frames.has(r["node"]):
		return int(_child_frames[r["node"]])
	return _lib_current_frame(r["lib"])


func child_exists(path: String) -> bool:
	## Flash `if (vis.osn.body.head.morda.hair)` (UnitPlayer.as:2983): the
	## instance is on its container's current frame (its frame ranges), not
	## hidden as an alternate-library child. A bone or a root attachment
	## exists whenever the path resolves. Visibility gates (transp, hair1,
	## set_child_visible) do not matter: a hidden clip still exists in Flash.
	## Step 16.1 (driver item F, the hair spring gate).
	var r := _resolve_child(_split_path(path))
	if r.is_empty():
		return false
	var entry: Dictionary = r["entry"]
	if entry.is_empty():
		return true
	if _is_alt_lib_child(entry["bone_name"], entry["vis_lib"]):
		return false
	return _frame_in_ranges(entry, _container_frame_of(entry))


func child_play(path: String, from_frame: int = 1) -> bool:
	## Flash `<path>.gotoAndPlay(n)` (`play()` = from its current frame): the
	## child's own timeline runs on from the 1-based frame under the display
	## convention — its stop()/goto scripts, random starts, wrap at the end —
	## as a ticker on that node alone. False when the path does not exist.
	var r := _resolve_child(_split_path(path))
	if r.is_empty():
		return false
	var frame := _child_frame_of(r["lib"], from_frame)
	if frame < 0:
		return false
	return _child_play_resolved(r, frame)


func set_child_visible(path: String, is_visible: bool) -> bool:
	## Flash `<path>.visible = v`. A nested clip keeps the gate across armour
	## and library changes (like a frame script's `mark.visible=false`); a
	## bone or attachment is overridden after the animation every frame.
	if _pre_ready(set_child_visible.bind(path, is_visible)): return true
	var r := _resolve_child(_split_path(path))
	if r.is_empty():
		return false
	var entry: Dictionary = r["entry"]
	if not entry.is_empty():
		_child_hidden["%s/%s" % [entry["bone_name"], entry["library"]]] = not is_visible
		_refresh_nested_entry(entry)
	else:
		_child_overrides.get_or_add(r["node"], {})["visible"] = is_visible
		(r["node"] as Node2D).visible = is_visible
	return true


func set_child_transform(path: String, props: Dictionary) -> bool:
	## Flash property writes on a clip (`puha.rotation = deg`, `t1.scaleX =
	## storona`, `vzz.rotation`): keys `rotation` (radians), `rotation_deg`,
	## `scale` (Vector2), `scale_x`, `scale_y`, `position` (Vector2), `x`,
	## `y`, `alpha`. Applied now and re-applied after the AnimationPlayer and
	## the tickers every frame, so keyed bones and per-frame nested
	## transforms do not undo them; clear_child_transform() removes them.
	if _pre_ready(set_child_transform.bind(path, props)): return true
	var r := _resolve_child(_split_path(path))
	if r.is_empty():
		return false
	var ov: Dictionary = _child_overrides.get_or_add(r["node"], {})
	for key in props:
		ov[str(key)] = props[key]
	_apply_child_override(r["node"], ov)
	return true


func clear_child_transform(path: String) -> void:
	## Forget the overrides of set_child_visible/set_child_transform on a node.
	var r := _resolve_child(_split_path(path))
	if not r.is_empty():
		_child_overrides.erase(r["node"])


func get_child_frame(path: String) -> int:
	## Flash `<path>.currentFrame` (1-based): the frame the child was sent to
	## by child_goto/child_play/a frame script or a ticker, else the frame
	## its symbol sits on (label variant); -1 when the path does not exist.
	var r := _resolve_child(_split_path(path))
	if r.is_empty():
		return -1
	if _child_frames.has(r["node"]):
		return int(_child_frames[r["node"]]) + 1
	return _lib_current_frame(r["lib"]) + 1


func get_osn_frame() -> int:
	## Flash `vis.osn.currentFrame` (1-based): the frame of the state
	## timeline — the animation's source frame when the state symbol is the
	## bone timeline itself (turrets: get_flash_frame), else the labelled
	## frame of the state the current animation belongs to.
	## R3 #4 (Step 16.1): on a rig with a state list (label_timeline rigs and
	## the self rigs whose sections carry states: captive, the vendors, …) this
	## is the state's label frame, NOT the playhead — a captive at rest reads 2
	## (`open`), a vendor anywhere in move1 reads 1 — and it does not move while
	## the section plays. A driver that follows a playing sequence reads
	## get_flash_frame() (the source-timeline playhead, Flash
	## `vis.osn.body.currentFrame` / the self rig's `vis.osn.currentFrame`);
	## only the rigs without a state list (turrets, roller, spritebot) return
	## the playhead here.
	if _animation_states.is_empty():
		return get_flash_frame()
	var source := str(get_anim_meta(get_current_anim()).get("source", ""))
	for state: Dictionary in _animation_states:
		if str(state.get("label", "")) == _current_state and _current_state != "":
			return int(state.get("frame", state["index"])) + 1
	for state: Dictionary in _animation_states:
		var anim := str(state.get("animation", ""))
		if anim != "" and str(get_anim_meta(anim).get("source", anim)) == source:
			return int(state.get("frame", state["index"])) + 1
	return 1


func _split_path(path: String) -> Array:
	var parts: Array = []
	for p in path.split(".", false):
		parts.append(p.strip_edges())
	return parts


func _bone_node_for_instance(inst: String) -> String:
	## The bone node an XFL instance name addresses: the explicitly named
	## instance first (two `sleg1` — the far leg is the named one), then any
	## bone with that instance name, then a node name.
	var cands: Array = _bones_by_instance.get(inst, [])
	for c: Dictionary in cands:
		if c["named"] and _bones.has(c["node"]):
			return c["node"]
	for c: Dictionary in cands:
		if _bones.has(c["node"]):
			return c["node"]
	if _bones.has(inst):
		return inst
	return ""


func _is_child_of(node: Node, parent: Node) -> bool:
	## Direct child of `parent`, or under the mask_clip the generator put
	## between them.
	var p: Node = node.get_parent()
	if p == parent:
		return true
	return _is_mask_container(p) and p.get_parent() == parent


func _resolve_child(parts: Array) -> Dictionary:
	## {node, lib, entry (the nested entry, {} for a bone/attachment), bone}
	## for an instance path; {} when any element is missing.
	var path := parts.duplicate()
	if not path.is_empty() and (str(path[0]) == "osn" or str(path[0]) == ""):
		path.remove_at(0)
	if path.is_empty():
		return {}
	var first := str(path[0])
	var r := {}
	if _attachments.has(first):
		r = {"node": _attachments[first], "lib": _strip_lib_prefix(_bone_lib.get("@" + first, "")),
				"entry": {}, "bone": "@" + first}
	else:
		var bone := _bone_node_for_instance(first)
		if bone == "":
			return {}
		r = {"node": _bones[bone], "lib": _strip_lib_prefix(_bone_lib.get(bone, "")),
				"entry": {}, "bone": bone}
	return _resolve_child_path(r, path, 1)


func _resolve_child_path(r: Dictionary, path: Array, from_i: int) -> Dictionary:
	## Walk path[from_i..] down from the resolved node `r`: each element is
	## the XFL instance name of a nested child of the current node (an
	## unnamed child matches by library), the child present at the node's
	## current frame first, else the first match; {} when an element is
	## missing.
	for i in range(from_i, path.size()):
		var name := str(path[i])
		var cur_frame: int = _child_frames.get(r["node"], _lib_current_frame(r["lib"]))
		var found := {}
		var fallback := {}
		for entry: Dictionary in _nested:
			if entry["bone_name"] != r["bone"] or entry["vis_lib"] != r["lib"]:
				continue
			if not _is_child_of(entry["node"], r["node"]):
				continue
			var inst := str(entry.get("instance", ""))
			var matches := (inst == name) if inst != "" else (str(entry["library"]) == name)
			if not matches:
				continue
			if _frame_in_ranges(entry, cur_frame):
				found = entry
				break
			if fallback.is_empty():
				fallback = entry
		if found.is_empty():
			found = fallback
		if found.is_empty():
			return {}
		r = {"node": found["node"], "lib": found["library"], "entry": found, "bone": r["bone"]}
	return r


func _lib_total_frames(lib: String) -> int:
	## Frames of a symbol's own timeline (symbols/<lib>.json `timeline`; 1
	## for a single-frame symbol).
	return maxi(int(_body_parts.get(lib, {}).get("timeline", {}).get("frames", 1)), 1)


func _child_frame_of(lib: String, target: Variant) -> int:
	## 0-based frame of a 1-based number (clamped) or a timeline label
	## (`timeline.labels`, else `armor_labels`); -1 for an unknown label.
	var total := _lib_total_frames(lib)
	if target is String:
		var bp: Dictionary = _body_parts.get(lib, {})
		var labels: Dictionary = bp.get("timeline", {}).get("labels", {})
		if labels.has(target):
			return clampi(int(labels[target]), 0, total - 1)
		var armor: Dictionary = bp.get("armor_labels", {})
		for idx: String in armor:
			if str(armor[idx]) == str(target):
				return clampi(int(idx), 0, total - 1)
		return -1
	return clampi(int(target) - 1, 0, total - 1)


func _show_child_frame(r: Dictionary, frame: int) -> void:
	## Show `frame` of the child's own symbol on that node: its keyframe
	## artwork (leaf sprite or the node's artwork sprites per layer; a layer
	## without art on the frame shows nothing) and the children it holds.
	var node: Node2D = r["node"]
	var lib: String = r["lib"]
	_child_frames[node] = frame
	_lib_held_frame[lib] = frame
	_graphic_shown[node] = "%s:%d" % [lib, frame]
	var key := str(frame)
	var bp: Dictionary = _body_parts.get(lib, {})
	if node is Sprite2D:
		var svg := str(bp.get("svg_files", {}).get(key, ""))
		if svg == "":
			(node as Sprite2D).texture = null
		else:
			_apply_texture(node, svg.replace(".svg", ""))
	else:
		for spr: Sprite2D in _container_artwork_sprites(node):
			var li := int(str(spr.get_meta("artwork_layer")))
			var si := int(str(spr.get_meta("element_index", 0)))
			var elem_list: Array = _get_element_svgs(lib, li).get(key, [])
			if si < elem_list.size():
				_apply_texture(spr, str(elem_list[si]).replace(".svg", ""))
				spr.visible = true
			else:
				spr.texture = null
				spr.visible = false
	_show_child_children(r, frame)


func _show_child_children(r: Dictionary, frame: int) -> void:
	## The nested children of one node follow its frame: shown by their
	## frame ranges (through the runtime gates) with their per-frame transform.
	for entry: Dictionary in _nested:
		if entry["vis_lib"] != r["lib"] or entry["bone_name"] != r["bone"]:
			continue
		if not _is_child_of(entry["node"], r["node"]):
			continue
		_show_child_entry(entry, frame)


func _show_lib_children(lib: String, frame: int) -> void:
	## Every instance of a library (an index ticker drives them in lockstep):
	## its children follow the frame — except inside a graphic instance,
	## whose frame the graphic sync derives from the parent timeline.
	for entry: Dictionary in _nested:
		if entry["vis_lib"] != lib:
			continue
		if _under_graphic_instance(entry):
			continue
		if _is_alt_lib_child(entry["bone_name"], entry["vis_lib"]):
			continue   # the bone shows another library now (_swap_bone_lib)
		var parent: Node = entry["node"].get_parent()
		if _is_mask_container(parent):
			parent = parent.get_parent()
		if _child_frames.has(parent):
			continue   # the container left the lockstep (_apply_ticker_frame)
		_show_child_entry(entry, frame)


func _show_child_entry(entry: Dictionary, parent_frame: int) -> void:
	## One nested child against its container's frame: visible by its frame
	## ranges (through the runtime gates), its per-frame transform, and — a
	## graphic instance of a multi-frame symbol — the frame of its own
	## timeline that Flash derives from the parent's (_graphic_frame), shown
	## through _show_child_frame, which recurses into its own children.
	var in_range := _frame_in_ranges(entry, parent_frame)
	entry["node"].visible = _nested_should_show(entry, in_range)
	if not in_range:
		return
	if not entry["frame_transforms"].is_empty() or not entry["frame_alpha"].is_empty():
		_apply_nested_frame_transform(entry, parent_frame)
	if entry.get("graphic", false) and _lib_total_frames(entry["library"]) > 1:
		var frame := _graphic_child_frame(entry, parent_frame)
		var key := "%s:%d" % [entry["library"], frame]
		if _graphic_shown.get(entry["node"], "") != key:
			_show_child_frame({"node": entry["node"], "lib": entry["library"],
					"entry": entry, "bone": entry["bone_name"]}, frame)


# =============================================================================
# Graphic symbols — instances that follow the parent timeline's frame
#
# A Flash graphic instance has no playhead of its own: on the parent frame p
# it shows frame ff + (p - k) of its library, where k is the start of the
# parent keyframe placing it and ff its firstFrame, wrapped modulo the
# library length for loop="loop", clamped at the last frame for "play once",
# held at ff for "single frame"; a graphic inside a graphic takes the outer
# one's displayed frame as its p. Bones placed as graphics get their spec
# from _set_bone_graphic METHOD keys (tools/manifest2tres.py, one key per
# spec change: exact under seeks because _start_anim replays the keys at or
# before the seek and then calls _update_graphic_frames); nested graphics
# take theirs from the symbol JSON (children[].loop / first_frame /
# graphic_keys) and are resolved by _show_child_entry from the frame their
# container shows.
# =============================================================================

static func _graphic_frame(loop: String, first_frame: int, kf_start: int,
		parent_frame: int, total: int) -> int:
	## Flash's rule (above), 0-based frames.
	if total <= 1:
		return 0
	if loop == "single frame":
		return clampi(first_frame, 0, total - 1)
	var d := first_frame + (parent_frame - kf_start)
	if loop == "play once":
		return clampi(d, 0, total - 1)
	return posmod(d, total)


func _graphic_child_frame(entry: Dictionary, parent_frame: int) -> int:
	## The frame a nested graphic shows when its container shows
	## `parent_frame`: the keyframe (frame range) covering the frame gives
	## the start and, through graphic_keys, its firstFrame / loop.
	var kf := -1
	for r: Vector2i in entry["frame_ranges"]:
		if r.x <= parent_frame and parent_frame <= r.y:
			kf = r.x
			break
	if kf < 0:
		return 0
	var ff := int(entry.get("first_frame", 0))
	var loop := str(entry.get("loop", "loop"))
	var gk: Dictionary = entry.get("graphic_keys", {})
	if gk.has(str(kf)):
		ff = int(gk[str(kf)][0])
		loop = str(gk[str(kf)][1])
	return _graphic_frame(loop, ff, kf, parent_frame, _lib_total_frames(entry["library"]))


func _set_bone_graphic(bone_name: String, first_frame: int, loop: String, kf_start: int) -> void:
	## METHOD-key target: the graphic playback spec of a bone from the
	## keyframe at `kf_start` (absolute source frame) on; loop "" clears it
	## (the bone is a MovieClip from there).
	if loop == "":
		_bone_graphic.erase(bone_name)
		return
	_bone_graphic[bone_name] = {"ff": first_frame, "loop": loop, "kf": kf_start}


func get_bone_graphic_frame(bone_name: String) -> int:
	## The 0-based frame a graphic bone shows now (-1: not a graphic bone
	## in the running animation). For the galleries and tests.
	if not _bone_graphic.has(bone_name):
		return -1
	var node: Node = _bones.get(bone_name)
	return int(_child_frames.get(node, -1)) if node != null else -1


func _update_graphic_frames() -> void:
	## Show, on every bone with a graphic spec, the frame Flash's rule gives
	## for the current source frame (frame_start + the animation frame), and
	## through it the frames of the graphics nested inside.
	if _bone_graphic.is_empty():
		return
	var anim_name := get_current_anim()
	if anim_name == "":
		return
	var sf := int(get_anim_meta(anim_name).get("frame_start", 0)) + get_current_frame()
	for bone_name: String in _bone_graphic:
		var node: Node2D = _bones.get(bone_name)
		if node == null:
			continue
		var spec: Dictionary = _bone_graphic[bone_name]
		var lib := _strip_lib_prefix(_bone_lib.get(bone_name, ""))
		var frame := _graphic_frame(str(spec["loop"]), int(spec["ff"]), int(spec["kf"]), sf,
				_lib_total_frames(lib))
		var key := "%s:%d" % [lib, frame]
		if _graphic_shown.get(node, "") == key:
			continue
		_show_child_frame({"node": node, "lib": lib, "entry": {}, "bone": bone_name}, frame)


func _sprites_of_node(r: Dictionary) -> Array:
	## Ticker sprite items for one resolved child: its leaf sprite, or the
	## artwork sprites the node holds directly.
	var items: Array = []
	var node: Node2D = r["node"]
	if node is Sprite2D:
		items.append({"sprite": node, "kind": "leaf"})
		return items
	for spr: Sprite2D in _container_artwork_sprites(node):
		items.append({"sprite": spr, "kind": "element",
				"layer": int(str(spr.get_meta("artwork_layer"))),
				"element": int(str(spr.get_meta("element_index", 0)))})
	return items


func _drop_dynamic_ticker(node: Node) -> void:
	for i in range(_tickers.size() - 1, -1, -1):
		var target: Variant = _tickers[i].get("target", null)
		if target is Dictionary and target["node"] == node:
			_tickers.remove_at(i)


func _child_play_resolved(r: Dictionary, frame: int) -> bool:
	## gotoAndPlay on a resolved child: simulate its own timeline from
	## `frame` and run it as a per-node ticker (a single held frame is just
	## shown).
	var sim := _simulate_child_timeline(r["lib"], frame)
	_drop_dynamic_ticker(r["node"])
	var frames: Array = sim["frames"]
	if frames.size() <= 1:
		_show_child_frame(r, int(frames[0]) if frames.size() == 1 else frame)
		return true
	var id := "child:%d" % (r["node"] as Node).get_instance_id()
	_add_ticker(id, r["lib"], _sprites_of_node(r), {
		"frames": frames, "loop_from": sim["loop_from"], "idle_frame": -1,
		"random_start": sim["random_start"], "scripts": sim["scripts"], "target": r})
	_set_ticker_active(id, true)
	# A key replayed on seek (_fire_method_keys_up_to): the clip has played
	# on since its frame — land where Flash would show it now.
	if _replay_elapsed_frames > 0.0:
		_advance_ticker(_ticker(id), _replay_elapsed_frames)
	return true


func _own_navigation(script: String) -> Dictionary:
	## The first own-timeline navigation call of a frame script and the
	## residual statements: {kind: "" | "stop" | "play" | "goto" | "random" |
	## "unknown", target (0-based frame or label), play, a, b, residual}.
	## Mirrors build_index._own_navigation.
	if _re_nav_head == null:
		_re_nav_head = RegEx.new()
		_re_nav_head.compile("(?<![\\w.])(stop|play|gotoAndPlay|gotoAndStop)\\s*\\(")
		# `Math.floor(Math.random()*K+B)`, `Math.floor(Math.random()*K)+B` and
		# `Math.floor(Math.random()*K)` (B = 0): a 1-based start in [B, B+K-1],
		# 0-based [B-1, B-1+K-1], clamped to the timeline (frame 0 for B = 0,
		# as Flash clamps gotoAndPlay(0) to frame 1). Same pattern as
		# build_index._RE_RANDOM.
		_re_random = RegEx.new()
		_re_random.compile("Math\\.random\\(\\)\\s*\\*\\s*(\\d+(?:\\.\\d+)?)\\s*\\)?\\s*(?:\\+\\s*(\\d+(?:\\.\\d+)?))?")
	var out := {"kind": "", "target": null, "play": false, "a": 0, "b": 0, "residual": []}
	var rest := script
	var spans: Array = []
	for m: RegExMatch in _re_nav_head.search_all(script):
		var depth := 1
		var i := m.get_end()
		while i < script.length() and depth > 0:
			var ch := script[i]
			if ch == "(":
				depth += 1
			elif ch == ")":
				depth -= 1
			i += 1
		spans.append(Vector2i(m.get_start(), i))
		if out["kind"] != "":
			continue
		var call := m.get_string(1)
		var arg := script.substr(m.get_end(), maxi(i - 1 - m.get_end(), 0)).strip_edges()
		if call == "stop" or call == "play":
			out["kind"] = call
			continue
		out["play"] = call == "gotoAndPlay"
		var rm := _re_random.search(arg)
		if rm != null:
			var k := int(float(rm.get_string(1)))
			var b := int(float(rm.get_string(2))) if rm.get_string(2) != "" else 0
			out["kind"] = "random"
			out["a"] = b - 1
			out["b"] = b - 1 + k - 1
		elif arg.begins_with("'") or arg.begins_with("\""):
			out["kind"] = "goto"
			out["target"] = arg.trim_prefix("'").trim_prefix("\"").trim_suffix("'").trim_suffix("\"")
		elif arg.is_valid_int():
			out["kind"] = "goto"
			out["target"] = int(arg) - 1
		else:
			out["kind"] = "unknown"
			out["target"] = arg
	for s: Vector2i in spans:
		rest = rest.substr(0, s.x) + " ".repeat(s.y - s.x) + rest.substr(s.y)
	for stmt in rest.split(";", false):
		if stmt.strip_edges() != "":
			out["residual"].append(stmt.strip_edges())
	return out


func _simulate_child_timeline(lib: String, start: int) -> Dictionary:
	## Play a symbol's own timeline from `start` under the display
	## convention (build_index._simulate_timeline): {frames, loop_from,
	## random_start, scripts}. frames = the displayed frames in order until
	## the play repeats (loop_from = index it returns to) or holds (-1).
	var tl: Dictionary = _body_parts.get(lib, {}).get("timeline", {})
	var total := maxi(int(tl.get("frames", 1)), 1)
	var navs: Dictionary = {}
	var residual: Dictionary = {}
	for fkey: String in tl.get("scripts", {}):
		var nav := _own_navigation(str(tl["scripts"][fkey]))
		if nav["kind"] != "":
			navs[int(fkey)] = nav
		if not (nav["residual"] as Array).is_empty():
			residual[str(int(fkey))] = "; ".join(nav["residual"])
	var labels: Dictionary = tl.get("labels", {})
	var seq: Array = []
	var pos: Dictionary = {}
	var loop_from := -1
	var random_start: Variant = null
	var f := clampi(start, 0, total - 1)
	for _guard in range(total * 2 + 8):
		if pos.has(f):
			loop_from = int(pos[f])
			break
		var nav: Dictionary = navs.get(f, {})
		var kind := str(nav.get("kind", ""))
		if kind == "" or kind == "play":
			pos[f] = seq.size()
			seq.append(f)
			f = f + 1 if f + 1 < total else 0
			continue
		if kind == "stop" or kind == "unknown":
			pos[f] = seq.size()
			seq.append(f)
			break
		var target: Variant = nav["target"]
		var play: bool = nav["play"]
		if kind == "random":
			var a := clampi(int(nav["a"]), 0, total - 1)
			var b := clampi(int(nav["b"]), 0, total - 1)
			if f == start and seq.is_empty() and play:
				seq = range(total)
				loop_from = 0
				random_start = [a, b]
				break
			target = a
		if target is String:
			if not labels.has(target):
				pos[f] = seq.size()
				seq.append(f)
				break
			target = int(labels[target])
		var tf := clampi(int(target), 0, total - 1)
		if play:
			f = tf
			continue
		if pos.has(tf):
			seq = seq.slice(0, int(pos[tf]) + 1)
		else:
			seq.append(tf)
		break
	if seq.is_empty():
		seq.append(f)
	var scripts: Dictionary = {}
	for fr in seq:
		if residual.has(str(fr)):
			scripts[str(fr)] = residual[str(fr)]
	return {"frames": seq, "loop_from": loop_from, "random_start": random_start,
			"scripts": scripts}


func _apply_child_override(node: Node2D, ov: Dictionary) -> void:
	for key: String in ov:
		var v: Variant = ov[key]
		match key:
			"visible":
				node.visible = bool(v)
			"rotation":
				node.rotation = float(v)
			"rotation_deg":
				node.rotation = deg_to_rad(float(v))
			"scale":
				node.scale = v
			"scale_x":
				node.scale.x = float(v)
			"scale_y":
				node.scale.y = float(v)
			"position":
				node.position = v
			"x":
				node.position.x = float(v)
			"y":
				node.position.y = float(v)
			"alpha":
				node.modulate.a = float(v)


# =============================================================================
# VisBase (Step 10.2, decision V1): thin wrappers over the API above, so a rig
# is driven like every other `vis`. Frames are 1-based Flash frames of the
# current source timeline. Calls made before `_ready` (a rig instantiated by
# VisRegistry and not yet in the tree, like `new X()` before addChild) are
# queued on the `ready` signal and replayed in order.
# =============================================================================

var _vis_kids: Dictionary = {}   # child path -> RigChildVis (off-tree proxies)


## Step 16.5 (the 15.3 request): the pre-ready rule of the driving API. A setter
## or playhead call made before `_ready` (a rig built by VisRegistry and not yet
## in the tree — `new X()` before addChild, UnitPlayer.attach's die pose, a
## unit's constructor) is queued and replayed in order once the rig is ready
## (after its default pose); a bool-returning call answers true when queued.
## The getters return their empty value before `_ready` ("" / {} / 0).
var _preq: Array = []


func _pre_ready(c: Callable) -> bool:
	if is_node_ready() and _anim_player != null:
		return false
	if _preq.is_empty():
		ready.connect(_flush_preq, CONNECT_ONE_SHOT)
	_preq.append(c)
	return true


func _flush_preq() -> void:
	var q: Array = _preq
	_preq = []
	for c: Callable in q:
		c.call()


func _vis_defer(c: Callable) -> bool:
	return _pre_ready(c)   # 16.5: one ordered queue (a repeated pre-ready write no longer double-connects `ready`)


## The source timeline of the running section (`body_stay`, `osn0`, …).
func _vis_source() -> String:
	var cur := get_current_anim()
	return str(get_anim_meta(cur).get("source", cur))


## A section whose metadata/label is `label`: the current source's first.
func _vis_section_of_label(label: String) -> String:
	var src := _vis_source()
	var other := ""
	for anim_name in _anim_player.get_animation_list():
		var meta := get_anim_meta(anim_name)
		if str(meta.get("label", "")) != label:
			continue
		if str(meta.get("source", anim_name)) == src:
			return anim_name
		if other == "":
			other = anim_name
	return other


func _vis_is_state(label: String) -> bool:
	for state: Dictionary in _animation_states:
		if str(state.get("label", "")) == label:
			return true
	return false


## The root of a rig whose root holds an `osn` instance is a one-frame,
## label-less MovieClip in Flash (R3 #2, Step 16.1; `root_is_timeline`): its
## gotoAndStop(n)/gotoAndPlay(n)/play()/stop() change nothing, a label throws
## (missing_labels). The state timeline is `child("osn")` (Flash `vis.osn.*`),
## whose members are the _osn_* functions below. A root-timeline rig
## (root_is_timeline) keeps the 10.2 behaviour on the root itself.
## The 15 audit (B1 (2)): `vis.stop()` on Bloat/Turret/Msp/Sentinel/Robobrain
## froze the osn flipbook, Msp's `vis.gotoAndStop(aiState)` cleared the state.
func vis_goto(target) -> void:
	if _vis_defer(vis_goto.bind(target)):
		return
	if root_is_timeline:
		_osn_goto(target)
	elif target is String or target is StringName or AS3.i32(target) < 1:
		missing_labels += 1


func vis_play(target = null) -> void:
	if _vis_defer(vis_play.bind(target)):
		return
	if root_is_timeline:
		_osn_play(target)
	elif target != null and (target is String or target is StringName or AS3.i32(target) < 1):
		missing_labels += 1


func vis_stop() -> void:
	if _vis_defer(vis_stop):
		return
	if root_is_timeline:
		_osn_stop()


func has_label(label: String) -> bool:
	if _anim_player == null:
		return false
	return _osn_has_label(label) if root_is_timeline else false


## gotoAndStop(label | n) on the state timeline: a state label →
## set_anim_state; another label → hold frame 0 of the section labelled so
## (the current source first); n → hold_source_frame(<current source>, n) (n
## clamped to totalFrames).
func _osn_goto(target) -> void:
	if _vis_defer(_osn_goto.bind(target)):
		return
	if target is String or target is StringName:
		var label := str(target)
		if _vis_is_state(label):
			set_anim_state(label)
			return
		var sec := _vis_section_of_label(label)
		if sec == "":
			missing_labels += 1
			return
		hold_frame(sec, 0)
		return
	var n := AS3.i32(target)
	if n < 1:
		missing_labels += 1
		return
	n = mini(n, maxi(1, get_flash_total_frames(get_current_anim())))
	if not hold_source_frame(_vis_source(), n):
		missing_labels += 1


## gotoAndPlay(label | n) / play() on the state timeline: play_from_label
## (else the state, else the labelled section from its start) /
## play_source_frame / resume_anim.
func _osn_play(target = null) -> void:
	if _vis_defer(_osn_play.bind(target)):
		return
	if target == null:
		resume_anim()
		return
	if target is String or target is StringName:
		var label := str(target)
		if play_from_label(label):
			return
		if _vis_is_state(label):
			set_anim_state(label)
			return
		var sec := _vis_section_of_label(label)
		if sec == "":
			missing_labels += 1
			return
		play_from_frame(sec, 0)
		return
	var n := AS3.i32(target)
	if n < 1:
		missing_labels += 1
		return
	n = mini(n, maxi(1, get_flash_total_frames(get_current_anim())))
	if not play_source_frame(_vis_source(), n):
		missing_labels += 1


## stop() on the state timeline → pause_anim().
func _osn_stop() -> void:
	if _vis_defer(_osn_stop):
		return
	pause_anim()


func _osn_has_label(label: String) -> bool:
	if _anim_player == null:
		return false
	return has_state(label)


func _osn_current_frame() -> int:
	return get_flash_frame() if _anim_player != null else 1


func _osn_total_frames() -> int:
	return maxi(1, get_flash_total_frames(get_current_anim())) if _anim_player != null else 1


func _osn_playing() -> bool:
	return _anim_player != null and _anim_player.is_playing() and not is_anim_paused()


func _osn_current_label() -> String:
	return get_osn_label() if _anim_player != null else ""


## `vis.<path>`: a cached proxy over get_child_node/get_attachment (child_goto,
## get_child_frame, set_child_visible, the transform forwarding); `osn` is
## the state timeline (the _osn_* functions). Null when the path does not exist.
func child(path: String) -> VisBase:
	if _vis_kids.has(path):
		return _vis_kids[path]
	var is_osn := path == "osn"
	if not is_osn:
		if not is_node_ready():
			return null
		if get_child_node(path) == null and get_attachment(path) == null:
			return null
	var v := RigChildVis.new()
	v.rig = self
	v.path = path
	v.is_osn = is_osn
	v.name = path.replace(".", "_")
	v.symbol = "%s.%s" % [symbol, path]
	_vis_kids[path] = v
	_proxy_snapshot(v)
	return v


func _notification(what: int) -> void:
	if what == NOTIFICATION_PREDELETE:
		for k in _vis_kids:
			var v = _vis_kids[k]
			if is_instance_valid(v) and not v.is_inside_tree():
				v.free()
		_vis_kids.clear()


# The root getters: a one-frame label-less clip unless root_is_timeline.
func _vb_current_frame() -> int:
	return _osn_current_frame() if root_is_timeline else 1


func _vb_total_frames() -> int:
	return _osn_total_frames() if root_is_timeline else 1


func _vb_playing() -> bool:
	return _osn_playing() if root_is_timeline else false


func _vb_current_label() -> String:
	return _osn_current_label() if root_is_timeline else ""


# ---------------------------------------------------------------- Step 19.1: filters on `body`

## The rig is a filter host: `vis.osn.filters = arr` (UnitPlayer.as:2565) and
## `vis.filters = [...]` (emergence Unit.as:793, a held object) both land on the
## lone `osn/body` CanvasGroup (P1; every generated rig has exactly that one group).
## Emergence glows the whole `vis` in Flash, the root attachments included; here only
## `body` carries it (a recorded deviation, audit A3.8).
func _vb_fx_host() -> bool:
	return true


func _vb_filters_set(copies: Array) -> void:
	if _pre_ready(_vb_filters_set.bind(copies)): return
	if not (_body is CanvasGroup):
		push_error("rig_base: %s has no CanvasGroup body: filters not shown" % name)
		return
	_fx_filters = copies
	EntityEffects.group_show(_body as CanvasGroup, copies)
	_fx_update_post()


func _vb_filter_param(index: int, param: String, value) -> void:
	if _pre_ready(_vb_filter_param.bind(index, param, value)): return
	if not (_body is CanvasGroup) or index < 0 or index >= _fx_filters.size():
		return
	EntityEffects.group_set_param(_body as CanvasGroup, index, param, value)


## The rig root's blend mode: `body` is a CanvasGroup whose material reads only the
## group's own back buffer, never the scene behind it, so a root blend cannot be drawn
## in one pass: recorded in `fx_blend_refused`, the rig drawn normal (17's NecrBoss
## ghost; the in-group blend leaves are 19.2's).
func _vb_blend_set(v: String) -> void:
	var m := v.to_lower()
	fx_blend_refused = "" if (m == "" or m == "normal" or m == "layer") else m
	if fx_blend_refused != "":
		print_verbose("rig_base: %s: root blend '%s' recorded, drawn normal (a CanvasGroup cannot read the scene)" % [name, m])


## D8: while a stack is shown, the osn offset (set_ct_offset) and the whole-visual
## transform (set_color_transform) are applied to the FILTERED body by the stack's
## post-filter colour transform (outer after inner: mult = outer, offset = outer.mult
## × osn offset + outer offset); the bone materials keep their channel tints only.
## The root attachments (outside `body`) keep the outer transform in their materials.
func _fx_update_post() -> void:
	if not (_body is CanvasGroup):
		return
	var want := not _fx_filters.is_empty() and (_ct_outer_set or _ct_base_off_active)
	if want and _fx_att_mats.is_empty():
		for bone_name: String in _bone_materials:
			if bone_name.begins_with("@"):
				for mat: ShaderMaterial in _bone_materials[bone_name]:
					_fx_att_mats[mat] = true
	if want != _fx_post:
		_fx_post = want
		for bone_name: String in _bone_materials:
			for mat: ShaderMaterial in _bone_materials[bone_name]:
				_ct_base_of(mat)
				_write_ct(mat)
	if _fx_post:
		var m := _ct_outer_mult if _ct_outer_set else Color(1, 1, 1, 1)
		var o := _ct_outer_off if _ct_outer_set else Color(0, 0, 0, 0)
		var so := _fx_osn_off if _ct_base_off_active else Color(0, 0, 0, 0)
		EntityEffects.group_post_ct(_body as CanvasGroup, m,
				Color(so.r * m.r + o.r, so.g * m.g + o.g, so.b * m.b + o.b, so.a * m.a + o.a))
	else:
		EntityEffects.group_post_ct(_body as CanvasGroup, Color(1, 1, 1, 1), Color(0, 0, 0, 0))


## The post-filter colour transform in effect ([mult, offset]; identity when none).
func get_fx_post_ct() -> Array:
	var rec := FilterStack.record(_body) if _body != null else {}
	if rec.is_empty():
		return [Color(1, 1, 1, 1), Color(0, 0, 0, 0)]
	var mat: ShaderMaterial = rec["material"]
	return [mat.get_shader_parameter("post_ct_multiply"), mat.get_shader_parameter("post_ct_offset")]


## The shown filters (deep copies) and the body group (verifiers).
func get_fx_filters() -> Array:
	return _fx_filters


func get_body() -> CanvasItem:
	return _body


## Step 19.3 (D-J): `VisBase.snapshot` composes the shown sprites in bone order
## (VisSnapshot). A rig never added to the tree (Unit.initIcos' `Res.getVis`, Unit.as:1490)
## has not run _ready (no textures, no pose): it is readied under the tree root for the
## call and taken out again (its tickers draw from the rig's own generator; no World.random()).
func snapshot(ct: ColorTr = null) -> Image:
	if not is_node_ready() and not is_inside_tree() and get_parent() == null:
		var tree := Engine.get_main_loop() as SceneTree
		if tree != null and tree.root != null:
			tree.root.add_child(self)
			tree.root.remove_child(self)
	return super(ct)


## color_transform = ct → set_color_transform(ct.mult, ct.off / 255).
func _vb_color_transform_set(ct: ColorTr) -> void:
	if _vis_defer(_vb_color_transform_set.bind(ct)):
		return
	if ct == null:
		set_color_transform(Color(1, 1, 1, 1), Color(0, 0, 0, 0))
	else:
		set_color_transform(ct.mult, ct.off / 255.0)


## Own-space bounds: the union of the shown sprites' rectangles (the rig
## root's space; tree visibility walked up to the root, off-tree too).
func _rect() -> Rect2:
	var r := Rect2()
	var has_r := false
	for spr in _sprites_under(self):
		if spr.texture == null or not _vis_shown(spr):
			continue
		var t := Transform2D.IDENTITY
		var n: Node = spr
		while n != self and n != null:
			if n is Node2D:
				t = (n as Node2D).transform * t
			n = n.get_parent()
		var sr: Rect2 = t * spr.get_rect()
		r = r.merge(sr) if has_r else sr
		has_r = true
	return _vb_merge_added(r, has_r)


func _vis_shown(node: Node) -> bool:
	var n: Node = node
	while n != self and n != null:
		if n is CanvasItem and not (n as CanvasItem).visible:
			return false
		n = n.get_parent()
	return true


# -----------------------------------------------------------------------------
# R3 #3 (Step 16.1): the proxy transform forwarding. A RigChildVis is an
# off-tree Node2D: its native rotation/scale/position/modulate cannot be
# intercepted, so the rig polls its proxies — at the start of every _process
# and of every tick (advance_ticks) — and forwards a value that changed since
# the last forward: `vis.child("osn").rotation = r` → osn.rotation (as
# set_osn_rotation), `.scale` → osn.scale (set_osn_scale), `.modulate.a` /
# `set_alpha` → osn alpha (set_osn_alpha), `.position` → osn.position; on any
# other path set_child_transform(path, {rotation | scale | alpha | position})
# (kept after the AnimationPlayer every frame, like the Flash property write
# that detaches a clip from its timeline). The World autoload processes
# before every rig, so a write in World.step shows in the same frame;
# sync_child_proxies() forwards at once. Reads: the osn proxy follows
# set_osn_rotation/scale/alpha; a bone proxy holds its snapshot at creation
# and the last value written — read a bone's live transform through
# get_child_node(path). Frame-exact alternatives: set_osn_rotation /
# set_osn_alpha / set_osn_scale / set_child_transform directly.
# -----------------------------------------------------------------------------

const _PROXY_KEYS := ["rotation", "scale", "alpha", "position"]


static func _proxy_value(v: Node2D, key: String) -> Variant:
	match key:
		"rotation": return v.rotation
		"scale": return v.scale
		"alpha": return v.modulate.a
		"position": return v.position
	return null


func _proxy_target(v) -> Node2D:
	if v.is_osn:
		return _osn
	return get_child_node(v.path)


func _proxy_snapshot(v) -> void:
	## The proxy starts from its node's transform (when the rig is ready), so
	## a read before any write gives the clip's own value; `_last` = what is
	## forwarded already (nothing changed yet).
	var node: Node2D = _proxy_target(v) if is_node_ready() else null
	if node != null:
		v.rotation = node.rotation
		v.scale = node.scale
		v.position = node.position
		v.modulate.a = node.modulate.a
	for key: String in _PROXY_KEYS:
		v._last[key] = _proxy_value(v, key)


func _proxy_note(path: String, key: String, value: Variant) -> void:
	## A direct API write (set_osn_*) updates the proxy's value and its
	## forwarded state, so it reads current and is not forwarded back.
	var v = _vis_kids.get(path)
	if v == null or not is_instance_valid(v):
		return
	match key:
		"rotation": v.rotation = value
		"scale": v.scale = value
		"alpha": v.modulate.a = value
	v._last[key] = value


func _sync_child_proxies() -> void:
	if _vis_kids.is_empty() or _anim_player == null:
		return
	for path in _vis_kids:
		var v = _vis_kids[path]
		if not is_instance_valid(v):
			continue
		var changed := {}
		for key: String in _PROXY_KEYS:
			var cur: Variant = _proxy_value(v, key)
			if cur != v._last.get(key):
				changed[key] = cur
				v._last[key] = cur
		if changed.is_empty():
			continue
		if v.is_osn:
			if _osn == null:
				continue
			if changed.has("rotation"): _osn.rotation = float(changed["rotation"])
			if changed.has("scale"): _osn.scale = changed["scale"]
			if changed.has("alpha"): _osn.modulate.a = float(changed["alpha"])
			if changed.has("position"): _osn.position = changed["position"]
		else:
			set_child_transform(str(path), changed)


func sync_child_proxies() -> void:
	## Forward the proxy transform writes now (they are forwarded at the next
	## _process / tick otherwise).
	_sync_child_proxies()


## `vis.<path>` of a rig (Step 10.2): an off-tree VisBase proxy whose timeline
## members forward to the rig's child-clip API (`osn`: the state timeline,
## the rig's _osn_* functions); a `visible` write is forwarded to
## set_child_visible (CheckPoint.as `lock.visible = false`), the transform
## writes by the rig's poll (R3 #3 above).
class RigChildVis extends VisBase:
	var rig: Node = null
	var path: String = ""
	var is_osn: bool = false
	var _last: Dictionary = {}   # key -> value forwarded last (R3 #3)

	func vis_goto(target) -> void:
		if is_osn:
			rig._osn_goto(target)
		elif not rig.child_goto(path, target, false):
			missing_labels += 1

	func vis_play(target = null) -> void:
		if is_osn:
			rig._osn_play(target)
		elif target == null:
			rig.child_play(path, maxi(1, rig.get_child_frame(path)))
		elif not rig.child_goto(path, target, true):
			missing_labels += 1

	func vis_stop() -> void:
		if is_osn:
			rig._osn_stop()
		else:
			rig.child_goto(path, maxi(1, rig.get_child_frame(path)), false)

	func has_label(label: String) -> bool:
		if is_osn:
			return rig._osn_has_label(label)
		var r: Dictionary = rig._resolve_child(rig._split_path(path))
		return not r.is_empty() and rig._child_frame_of(r["lib"], label) >= 0

	func child(p: String) -> VisBase:
		return rig.child(p if is_osn else path + "." + p)

	func _vb_current_frame() -> int:
		if is_osn:
			return rig._osn_current_frame()
		return maxi(1, rig.get_child_frame(path))

	func _vb_total_frames() -> int:
		if is_osn:
			return rig._osn_total_frames()
		var r: Dictionary = rig._resolve_child(rig._split_path(path))
		return 1 if r.is_empty() else rig._lib_total_frames(r["lib"])

	func _vb_playing() -> bool:
		return rig._osn_playing() if is_osn else false

	func _vb_current_label() -> String:
		return rig._osn_current_label() if is_osn else ""

	func _notification(what: int) -> void:
		if what == NOTIFICATION_VISIBILITY_CHANGED and rig != null and is_instance_valid(rig):
			if is_osn:
				if rig._osn != null:
					rig._osn.visible = visible
			else:
				rig.set_child_visible(path, visible)

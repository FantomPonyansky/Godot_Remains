class_name RigBase
extends VisBase
## Generic runtime for a rig scene generated by the Step 04 pipeline
## (tools/manifest2tscn.py + tools/manifest2tres.py from a rig config).
##
## Owns everything that is data-driven and the same for every rig: loading the
## split JSON (index, hierarchy, state machine, symbols) and the PNG metadata,
## node discovery (bones, root attachments, nested children, element sprites,
## masked sprites, bitmap sprites), texture application, nested visibility by
## frame range and per-frame transforms, label variants (`armor_labels`),
## library switching, the per-animation bone draw order, playback (state
## labels, hold/play/label entries, frame getters, method-key replay,
## `next` chaining, signals), tickers (self-animating nested symbols, table
## supplied by the subclass), root transforms, blend/alpha-offset metadata,
## colour channels and offsets, refresh.
##
## Rig-specific behaviour (armour, eyes, wings, PipBuck, ...) lives in a
## subclass such as player_rig.gd, through the `_rig_*` hooks below.
##
## Paths: the scene root may carry `metadata/data_dir`, `metadata/art_dir`
## and `metadata/anim_library` (written by the generator for generic rigs);
## otherwise `_default_paths()` decides (the player subclass returns the
## player locations).

## Emitted when an animation reaches a named frame label (sub-animation marker).
signal frame_label_reached(label: String)
## Emitted when an animation passes a frame that carries a Flash `stop()`
## (the section boundaries already encode the hold; this is a marker).
signal frame_stop_reached(frame: int)
## Emitted after a finished animation chained into its `next` (Flash frame
## scripts `gotoAndStop('sit')`, levit intro -> hover, ...).
signal anim_chained(from_anim: String, to_anim: String, mode: String)
## Emitted when an animation finishes (before any `next` chaining), so the
## driver (UnitPlayer, Step 13) can react like Flash's `t_work` countdown.
signal state_finished(anim_name: String)
## A Flash frame script navigated a nested clip (`head.eye.gotoAndStop(2)`):
## path = the instance names, target = 0-based frame or label, node = the
## bone node the path starts at. Emitted after the generic handling.
signal child_goto_reached(path: Array, target: Variant, play: bool, node: String)
## A Flash frame script toggled a nested clip's visibility (`sleg1.mark.visible=false`).
signal child_visible_changed(path: Array, value: bool, node: String)
## A frame-script statement the compiler could not classify (verbatim text).
signal frame_script_reached(text: String)

const FPS := 30.0

# Flash Appear.as colour constants (colorToTransform: mult = byte/290 + 35/255)
const COLOR_MAX := 290.0
const COLOR_SHIFT := 35.0 / 255.0  # ~0.1373

## Load every raster the symbol tables name at start-up (the pre-04.8
## behaviour, for galleries and tests that walk many variants). False (the
## default): a texture is loaded on first use (_apply_texture / _texture),
## so a rig holds only the rasters it has shown. The scene root's
## `metadata/preload_textures` = true has the same effect.
@export var preload_all_textures: bool = false

# Resolved locations (see _resolve_paths)
var data_dir: String = ""
var art_dir: String = ""
var anim_library: String = ""

# Split manifest data (loaded once, kept in memory — small)
var _index: Dictionary
var _hierarchy: Dictionary
var _body_parts: Dictionary = {}       # lib_name -> symbol data
var _nested_hierarchies: Dictionary = {}  # container_name -> children array
var _animation_states: Array = []
var _color_channels: Dictionary = {}
# Flash default colours (index.json.default_colors, e.g. the Appear
# constructor's cFur/cHair/... for the player).
var _default_colors: Dictionary = {}

var _png_meta: Dictionary
var _textures: Dictionary = {}  # tex_name (no ext) -> Texture2D (null: no such PNG)
var _osn: Node2D
var _body: CanvasItem
var _anim_player: AnimationPlayer

# node_name -> Node2D bone container
var _bones: Dictionary = {}
# node_name -> library name for the bone's main sprite
var _bone_lib: Dictionary = {}
# Per-element artwork sprites — flat list of all element sprites across all bones:
# Array of {sprite: Sprite2D, lib: String, layer_index: int, element_index: int, bone_name: String}
var _element_sprites: Array[Dictionary] = []
# bone_name -> Array[Dictionary] (references into _element_sprites entries)
var _bone_element_sprites: Dictionary = {}

# Nested children metadata:
# Array of {node: Node, library: String, frame_start: int, frame_end: int,
#            vis_lib: String, bone_name: String, is_container: bool,
#            frame_transforms: Dictionary, default_position: Vector2, ...}
var _nested: Array[Dictionary] = []

# channel_name -> Array[ShaderMaterial]
var _channel_materials: Dictionary = {}
# bone_name -> Array[ShaderMaterial] (all materials in subtree, for brightness compensation)
var _bone_materials: Dictionary = {}
# Whether ct_offset is active on any material (death glow).
# When true, _process() syncs ct_brightness on affected bones.
var _ct_offset_active: bool = false

# Root-level attachments (Flash: siblings of osn under the root): hidden Node2D
# siblings of osn under the rig root, keyed by Flash instance name. Their
# nested entries and element sprites are registered under the pseudo bone
# name "@<name>" so the generic texture/visibility code covers them.
var _attachments: Dictionary = {}
# Animation whose bone draw order (sibling order under body) is applied.
var _current_bone_order: String = ""
# Sprite2Ds that show a DOMBitmapInstance: {sprite, png}
var _bitmap_sprites: Array[Dictionary] = []

# Label variant currently applied to the `armor_labels` symbols (the
# player's armour id; "" = frame 0 / unarmoured).
var _variant_id: String = ""
# Flash Appear.transp: hide every colour-channel instance.
var _transp: bool = false
# "<bone>/<library>" -> true when a frame script hid that nested clip
# (`<inst>.mark.visible=false`, set_mark_visible); survives armour/library changes.
var _child_hidden: Dictionary = {}
# State label last selected by set_anim_state (Flash `animState`)
var _current_state: String = ""

# Sprites clipped by a Flash mask layer of one symbol (metadata is_masked):
# Array of {sprite: Sprite2D, mat: ShaderMaterial}. They live under the
# mask_clip Node2D (identity transform), so their position/scale/offset are
# in the masked symbol's space, the space the mask viewBox uses.
var _masked_sprites: Array[Dictionary] = []
# Timeline masks (a self timeline's mask layer, index.json timeline_masks):
# [{source, layer, keyframes [[s, e, png]], sprites [{sprite, mat}],
# skipped, shown}] -- see _setup_timeline_masks.
var _tl_masks: Array[Dictionary] = []
var _tl_mask_open: ImageTexture            # 1x1 white: the clip switched off
const _MASKED_SHADER_PATH := "res://assets/rigs/shaders/color_transform_masked.gdshader"
var _mask_part_name: String = ""           # library whose mask applies
var _mask_origin: Vector2 = Vector2.ZERO   # mask viewBox origin (vx, vy)
var _mask_extent: Vector2 = Vector2.ONE    # mask viewBox size (vw, vh)
# bone node name -> default library and alternate libraries (index.json
# precomputed.bone_alt_libs); a nested child whose vis_lib is one of the
# bone's *other* libraries is hidden until _swap_bone_lib selects it.
var _bone_default_lib: Dictionary = {}
var _bone_alt_libs: Dictionary = {}

# Self-animating nested symbols (Flash MovieClips with their own timelines
# that the body timeline does not drive). Each ticker: {id, lib, sprites:
# Array of {sprite, kind ("leaf"|"element"), layer, element}, frames:
# Array[int], loop_from: int (-1 = hold the last frame), t: float (frames),
# last: int, active: bool, idle_frame: int (-1 = leave the texture as is)}.
# Registered by the subclass in _rig_setup_tickers(); advanced in _process
# at 30 fps (dt = delta * 30) like the Flash clips.
# Since the data-driven tickers (index.json `tickers`, the default
# _rig_setup_tickers) a row may also carry `random_start: [a, b]` (a new
# start frame drawn from [a, b] on activation and at every wrap — the NPC
# blink eyes' `gotoAndPlay(Math.floor(Math.random()*30+1))`), `scripts`
# ({frame: residual statement} reported through _on_frame_script when the
# ticker enters the frame) and `target` (a resolved child of child_play():
# the ticker drives that one node and the children its frames hold).
var _tickers: Array[Dictionary] = []
# The rig's random source (ticker random starts): set_rng_seed() makes a
# run reproducible.
var _rng: RandomNumberGenerator = RandomNumberGenerator.new()
# XFL instance name -> [{node, named}] of the hierarchy bones (child paths).
var _bones_by_instance: Dictionary = {}
# Node -> 0-based frame a child clip was sent to (child_goto, tickers).
var _child_frames: Dictionary = {}
# Node -> {property: value} written by set_child_visible/set_child_transform
# on a bone or attachment, re-applied after the AnimationPlayer every frame.
var _child_overrides: Dictionary = {}
# library -> 0-based frame held by child_goto / shown by an index ticker; the
# fallback of _lib_current_frame for symbols without armor_labels.
var _lib_held_frame: Dictionary = {}
# Own-timeline navigation calls of a frame script (child_play simulation).
var _re_nav_head: RegEx
var _re_random: RegEx
# Bone node name -> {ff, loop, kf}: the Flash graphic playback of a bone
# placed as a graphic symbol (_set_bone_graphic METHOD keys of the running
# animation; cleared on every entry). Flash shows frame ff + (source frame
# - kf) of the bone's library, wrapped for "loop", clamped for "play once",
# held at ff for "single frame"; _update_graphic_frames evaluates it every
# frame from the animation position (see manifest2tres.py: the compact
# form is exact under seeks once the keys at or before the seek are
# replayed).
var _bone_graphic: Dictionary = {}
# Node -> "<library>:<frame>" last shown by the graphic sync (skip re-shows).
var _graphic_shown: Dictionary = {}
# Source timeline (metadata/source) of the running animation. Flash rule:
# `osn.gotoAndStop(label)` instantiates that frame's body_* clip anew, so
# every nested clip starts at frame 0; only the keyframes of ONE timeline
# (the sections of one source) keep a persisting instance's playhead.
var _current_source: String = ""
# True once _apply_anim_entry ran (the first body instance is on): a later
# source change restarts the body's tickers (_reset_child_clips).
var _clips_entered: bool = false
# Frames elapsed since the METHOD key being replayed by _fire_method_keys_up_to
# (0 outside a replay): a replayed gotoAndPlay child key advances its ticker
# by this much so a seek lands on the child frame Flash would show.
var _replay_elapsed_frames: float = 0.0
# pause_anim() froze the body (Flash `body.stop()`); cleared by _start_anim
# and resume_anim().
var _held: bool = false
# Whole-visual colour transform (Flash `vis.transform.colorTransform`,
# set_color_transform): the outer multiply/offset, composed over the base
# values each material carries (channel tints, osn offset).
var _ct_outer_set: bool = false
var _ct_outer_mult: Color = Color(1, 1, 1, 1)
var _ct_outer_off: Color = Color(0, 0, 0, 0)
# ShaderMaterial -> base ct_multiply (set_channel_color/apply_default_colors,
# else the value the material had) and base ct_offset (set_ct_offset).
var _ct_base_mult: Dictionary = {}
var _ct_base_off: Dictionary = {}
# set_ct_offset (the osn offset) is non-zero.
var _ct_base_off_active: bool = false
# --- Step 19.1 (D-I, D-K, D8): the entity filter host on `body` ------------
# The shown filter list (deep copies, EntityEffects.group_show on _body).
var _fx_filters: Array = []
# True while a stack is shown and a colour transform is set: the osn offset and
# the whole-visual transform move from the bone materials to the stack's
# post-filter slot (Flash tints the filters' output); the attachments keep theirs.
var _fx_post: bool = false
var _fx_osn_off: Color = Color(0, 0, 0, 0)
var _fx_att_mats: Dictionary = {}
## A root blend mode the rig cannot draw (a CanvasGroup cannot read the scene
## behind it): recorded, the rig drawn normal ("" when none). NecrBoss's ghost (17).
var fx_blend_refused: String = ""
# Animation libraries whose METHOD keys were checked (_check_method_keys):
# resource path -> true; one report per library and process.
static var _checked_libraries: Dictionary = {}

# --- Step 16.1 (contract R3) -------------------------------------------------
# R3 #5 tick-driven playback (set_tick_driven / advance_ticks): the
# AnimationPlayer runs MANUAL and the rig advances one Flash frame per game
# tick; _process advances nothing on a frame that was claimed. Three clocks
# (the block before set_tick_driven): the process clock (default), the World
# clock (set_world_clocked: World.register_clip advances the rig by
# World.ticks before the cascade — decision D1 of the 2026-10-05 fix pass,
# review B1) and the driver's own ticks (set_tick_driven(true) from a driver:
# advance_ticks(1) per animate tick, the World registry left).
var _tick_driven: bool = false
var _world_clocked: bool = false     # D1: the World advances it (register_clip)
var _driver_frame: int = -1          # Engine.get_process_frames() of the last advance_ticks
var _self_acc: float = 0.0           # the fallback tick accumulator (no World node at all)
var _ticks_advanced: int = 0         # Flash frames advanced since _ready (get_ticks_advanced)
var _idle_process_mode: int = AnimationMixer.ANIMATION_CALLBACK_MODE_PROCESS_IDLE
# R3 #7 the facing bookkeeping: the sign of scale.x last reported to
# _rig_on_facing_changed (set_facing, or a direct `scale.x = storona` write by
# Unit.setVisPos, read in _process / advance_ticks).
var _facing_seen: bool = true
## R3 #2: true when the rig root IS the timeline the sections come from (a
## root-timeline rig, index.json rig.state_instance == ""): the root
## vis_goto/vis_play/vis_stop act on the sections as before. False (every rig
## whose root holds an `osn` state instance; their root symbol has one frame,
## checked over the 87 rigs on 2026-10-05): the root is a one-frame,
## label-less MovieClip — gotoAndStop(n)/gotoAndPlay(n)/play()/stop() change
## nothing, a label is an unknown label (Flash throws: missing_labels), and the
## state timeline is `child("osn")` (Flash `vis.osn.*`). Set from the rig data
## in _ready; a driver may override it.
var root_is_timeline: bool = false


# =============================================================================
# Hooks for subclasses
# =============================================================================

func _default_paths() -> Dictionary:
	## Locations when the scene root carries no path metadata.
	return {"data_dir": "res://data/rig/", "art_dir": "res://art/rig/",
			"anim_library": ""}


func _rig_load_data() -> void:
	## Read rig-specific fields of index.json after the generic ones.
	pass


func _rig_cache_refs() -> void:
	## Cache nested nodes the subclass drives at runtime.
	pass


func _rig_load_textures() -> void:
	## Load textures outside the symbol tables (e.g. shape masks).
	pass


func _rig_setup_visuals() -> void:
	## One-time material/shader setup after textures are applied.
	pass


func _rig_setup_tickers() -> void:
	## Register tickers with _add_ticker(); called once at start-up. Default:
	## every row of index.json `tickers` (a library whose own timeline plays
	## on from frame 0) on every sprite that shows that library — Flash plays
	## each nested MovieClip on its own. The player overrides with its table.
	_setup_index_tickers()


func _rig_update_ticker_activity() -> void:
	## Decide which tickers run from the rig state. Default: every index
	## ticker runs (Flash plays every clip that exists).
	for t: Dictionary in _tickers:
		if t.get("from_index", false):
			_set_ticker_active(str(t["id"]), true)


func _rig_ready() -> void:
	## Runtime defaults before the idle pose is applied.
	pass


func _rig_after_ready() -> void:
	## After the idle pose is applied.
	pass


func _rig_process(_delta: float) -> void:
	## Per-frame overrides that Flash applies in code (after the AnimationPlayer).
	pass


func _rig_lib_frame(_lib: String) -> int:
	## The frame a container symbol without `armor_labels` sits on (eye style,
	## face, hair ...); 0 when the subclass has no rule.
	return 0


func _rig_nested_gate(_entry: Dictionary) -> bool:
	## Extra visibility gates on a nested child that is in range and not
	## hidden by transparency (hair1, cutie mark ...). True = show.
	return true


func _rig_refresh_variant() -> void:
	## Re-apply the subclass's runtime state (refresh_visuals). Default: the
	## label variant only.
	_apply_variant(_variant_id)


func _rig_replay_methods() -> Array[String]:
	## Method-track calls replayed on entry (they do not fire on seek): the
	## state-changing ones. Marker keys (labels, stop, goto, bone order,
	## frame scripts) are not replayed.
	return ["_swap_bone_lib", "_set_bone_graphic", "_on_child_goto", "_on_child_visible",
			"set_mark_visible"]


func _rig_on_bone_lib_swapped(_bone_name: String, _lib_name: String) -> void:
	## A bone changed library (tickers may depend on it).
	pass


func _rig_on_facing_changed(_right: bool) -> void:
	## The rig was mirrored by set_facing.
	pass


func _rig_default_idle() -> String:
	## Animation held at start-up when neither the scene nor the index names one.
	return ""


func _rig_mark_libraries() -> Array:
	## Libraries that are a cutie mark (`<inst>.mark.visible=false` targets):
	## index.json.rig.mark_libraries (build_index.py: the libraries of the
	## instances the config's set_mark_visible paths name, `quti` in every
	## rig), else the default for an index written before that key.
	var rig: Dictionary = _index.get("rig", {})
	if rig.has("mark_libraries"):
		return rig["mark_libraries"]
	return ["quti", "mark"]


# =============================================================================
# Lifecycle
# =============================================================================

func _ready() -> void:
	# Rasters are 3 texels per screen pixel at camera scale 1 and are shown at
	# 0.222-2.0 (Flash Camera.scaleV). Asset-fidelity P2 (2026-10-12): bilinear (no
	# mipmaps since 26.7 -- Godot's trilinear chain over-blurred, 26.7's table), and the
	# minification is the parts' shaders' footprint sampling (footprint.gdshaderinc,
	# turned on per material by _localize_materials): N x N taps over the pixel.
	texture_filter = CanvasItem.TEXTURE_FILTER_LINEAR
	_localize_materials()
	_resolve_paths()
	_load_data()
	root_is_timeline = str(_index.get("rig", {}).get("state_instance", "osn")) == ""
	_rig_load_data()
	_create_animation_player()
	_discover_nodes()
	_discover_element_sprites()
	_rig_cache_refs()
	if preload_all_textures or bool(get_meta("preload_textures", false)):
		_load_textures()
	_rig_load_textures()
	_apply_all_textures()
	_setup_masks()
	_setup_timeline_masks()
	_set_initial_visibility()
	_apply_blend_modes()
	_rig_setup_visuals()
	_rig_setup_tickers()
	_rig_update_ticker_activity()
	_build_channel_map()
	_build_bone_materials()
	_rig_ready()
	# Default pose: hold the idle animation's frame 0 (Flash: a fresh visual
	# sits on its first state frame). Without it every bone is visible and the
	# scene defaults show.
	var idle := _idle_animation()
	if idle != "" and _anim_player.has_animation(idle):
		hold_frame(idle, 0)
		_current_state = _state_label_of(idle)
	_rig_after_ready()


## Step 16.5 (16.3 gap 4): the scene's ShaderMaterials are sub-resources shared by
## every instance of the PackedScene, so a colour transform written on one rig
## (the player's die offset, the appearance channels) outlived it into the next
## instance (whose `_ct_base_of` then recorded the stale values as its base). Each
## instance takes its own copies before anything caches a material; sprites that
## shared one material keep sharing one copy (the batching stays).
func _localize_materials() -> void:
	var copies := {}
	var stack: Array[Node] = [self]
	while not stack.is_empty():
		var n: Node = stack.pop_back()
		if n is CanvasItem:
			var m: Material = (n as CanvasItem).material
			if m is ShaderMaterial:
				if not copies.has(m):
					copies[m] = m.duplicate()
					_fp_enable(copies[m])
				(n as CanvasItem).material = copies[m]
		for c in n.get_children():
			stack.append(c)


## Asset-fidelity P2 (2026-10-12): the footprint sampling of a part material (the rig's
## colour-transform shaders, footprint.gdshaderinc; off by default for every other user).
static var footprint_on := true   # a measurement switch (effects_spike `--p2=off`)


static func _fp_enable(m: Material) -> void:
	if not footprint_on:
		return
	var sm := m as ShaderMaterial
	if sm != null and sm.shader != null and sm.shader.resource_path.begins_with("res://assets/rigs/shaders/color_transform"):
		sm.set_shader_parameter("footprint", 1.0)


func _process(delta: float) -> void:
	_sync_child_proxies()
	_sync_root_alpha()
	_check_facing()
	if _tick_driven:
		_process_tick_driven(delta)
		return
	_rig_process(delta)

	# Sync ct_brightness on all materials when ct_offset is active.
	# Brightness is animated via Node2D.modulate (interpolated, seekable,
	# inherits to children). The shader pre-divides ct_offset by ct_brightness
	# so modulate cancels out: offset survives unchanged.
	if _ct_offset_active:
		for bone_name: String in _bone_materials:
			var bone: Node2D = _bones.get(bone_name)
			if bone == null:
				continue  # attachments ("@…") carry no offset
			var br: float = bone.modulate.r  # RGB equal for brightness
			var materials: Array = _bone_materials[bone_name]
			for mat: ShaderMaterial in materials:
				mat.set_shader_parameter("ct_brightness", br)

	# Self-animating nested symbols: advance at 30 frames per second of game time.
	_advance_tickers(delta)

	# Driver writes on bones/attachments (set_child_visible/set_child_transform:
	# `t1.scaleX = storona`, `pole.visible = false`) outlive the keyed values.
	for node in _child_overrides:
		if is_instance_valid(node):
			_apply_child_override(node, _child_overrides[node])


# =============================================================================
# Step 16.1 (contract R3 #5): tick-driven playback
#
# Flash advances every playhead once per frame on frame entry, then runs
# ENTER_FRAME (World.step -> UnitPlayer.animate), which reads currentFrame.
# A rig on the process clock drifts against the driver's per-tick counters
# (0 or 2 ticks in a frame). Tick-driven, the AnimationPlayer is MANUAL and
# advance_ticks(n) steps the rig one Flash frame at a time: the animation
# (IMMEDIATE METHOD keys and `next` chains fire inside the advance), the
# tickers by one frame, then the per-frame rig work (_rig_process: the
# player's wings and PipBuck), the colour-offset sync and the child
# overrides. The driver calls advance_ticks(1) at the top of each animate
# tick, before it reads a frame (UnitPlayer.as:2568).
#
# The three clocks of a rig (fix pass 2026-10-05, decision D1, review B1):
#
#   process clock (the default, set_tick_driven(false)): the AnimationPlayer
#     runs on its IDLE process callback and _process advances the tickers by
#     delta — Part B, the galleries, verify_rig_ticks pass 1 (bit-exact code
#     path of before 16.1). A rig in the game never runs on it.
#   world-clocked (set_world_clocked(true); VisRegistry.make puts every rig
#     it instantiates here): tick-driven, and registered with the World
#     autoload (World.register_clip) while in the tree — World._process calls
#     advance_ticks(World.ticks) after the tick rule and before the cascade,
#     so the logic reads the frame that will be rendered, as Flash advances
#     every playhead on frame entry and only then runs ENTER_FRAME. The
#     registered rig's own _process does the idempotent per-frame work only.
#   driver-owned (set_tick_driven(true) from a driver: UnitPlayer._init_visual,
#     the Step 15 harness): tick-driven, unregistered from the World — the
#     driver's advance_ticks(1) at the top of each animate tick is the only
#     advance (UnitPlayer.as:2568), the frame claimed; a frame without a
#     driver call (allStat 2 — the PipBuck, SATS, a dialog — catPause, a
#     player not stepped) advances by World.ticks in _process, the ticks the
#     World ran in that frame — Flash never pauses the rig (stopAnim /
#     pause_anim is the only pause), and a frame with 0 ticks advances nothing.
#
# The self-advance fallback of _process_tick_driven covers a tick-driven rig
# no one advanced this frame: World.ticks when a World node exists (the
# autoloads load under `--path --script` too — verified 2026-10-05, E1 C2),
# else the own accumulator with the World's rule (acc += min(delta*30, 3);
# n = floor(acc + 0.1)) — a scene run outside the project. advance_ticks(0)
# claims the frame without advancing. A frame with both (a driver after the
# rig's _process) cannot happen in the game: the World autoload processes
# before every scene node.
#
# set_tick_driven(false) restores the process mode and the code path of
# before (bit-exact: Part B, the galleries, verify_rig_ticks pass 1); any
# set_tick_driven call ends the world-clocked mode (the driver owns the rig).
# =============================================================================

func set_tick_driven(on: bool) -> void:
	## Switch the rig between the process clock (false, the default) and the
	## driver's ticks (true: AnimationPlayer MANUAL, advance_ticks). Callable
	## before _ready (applied when the player is created). A driver's call:
	## the rig leaves the World clock (D1 — driver-owned), whatever `on`.
	if _world_clocked:
		_world_clocked = false
		_unregister_clip()
	_set_tick_mode(on)


func set_world_clocked(on: bool) -> void:
	## D1: on — tick-driven and advanced by World._process (register_clip,
	## while in the tree; _enter_tree registers a rig clocked before it was
	## added); off — unregistered (the mode stays tick-driven: the self-advance
	## fallback drives it after the cascade). Callable before _ready.
	if on == _world_clocked:
		return
	_world_clocked = on
	if on:
		_set_tick_mode(true)
		if is_inside_tree():
			_register_clip()
	else:
		_unregister_clip()


func is_world_clocked() -> bool:
	return _world_clocked


func _set_tick_mode(on: bool) -> void:
	## The MANUAL / IDLE switch shared by the world and driver clocks.
	if on == _tick_driven:
		return
	_tick_driven = on
	_self_acc = 0.0
	_driver_frame = -1
	if _anim_player == null:
		return
	if on:
		_idle_process_mode = _anim_player.callback_mode_process
		_anim_player.callback_mode_process = AnimationMixer.ANIMATION_CALLBACK_MODE_PROCESS_MANUAL
	else:
		_anim_player.callback_mode_process = _idle_process_mode


func _world_node() -> Node:
	## The World autoload when it exists (null in a scene run outside the project).
	var ml := Engine.get_main_loop() as SceneTree
	return ml.root.get_node_or_null(^"World") if ml != null else null


func _register_clip() -> void:
	var w := _world_node()
	if w != null and w.has_method("register_clip"):
		w.call("register_clip", self)


func _unregister_clip() -> void:
	var w := _world_node()
	if w != null and w.has_method("unregister_clip"):
		w.call("unregister_clip", self)


func _enter_tree() -> void:
	if _world_clocked:
		_register_clip()


func is_tick_driven() -> bool:
	return _tick_driven


func get_ticks_advanced() -> int:
	## Flash frames the rig advanced since _ready (every clock; tests).
	return _ticks_advanced


func advance_ticks(n: int = 1) -> void:
	## Advance a tick-driven rig by n Flash frames, one at a time, and claim
	## this process frame (its _process advances nothing). n = 0 only claims.
	## Ignored before _ready and when not tick-driven. The World calls it
	## with World.ticks on a world-clocked rig (D1), a driver with 1 per tick.
	if not _tick_driven or _anim_player == null:
		return
	_driver_frame = Engine.get_process_frames()
	for i in n:
		_tick_once()


func _tick_once() -> void:
	## One Flash frame: the animation (a held or finished one does not move —
	## AnimationPlayer.advance moves a paused player, so it is skipped), the
	## tickers, the per-frame rig work, the brightness sync, the overrides.
	_sync_child_proxies()
	_sync_root_alpha()
	_check_facing()
	_ticks_advanced += 1
	if _anim_player.is_playing():
		_anim_player.advance(_tick_step())
	for t: Dictionary in _tickers:
		if t["active"]:
			_advance_ticker(t, 1.0)
	_rig_process(1.0 / FPS)
	_sync_ct_brightness_bones()
	for node in _child_overrides:
		if is_instance_valid(node):
			_apply_child_override(node, _child_overrides[node])


# The loop wrap of a tick step. Animation.length is a float32 and the
# player's position a double: N advances of 1/30 sum to a double just BELOW
# float32(N/30) for most N (0.8 -> 0.80000001 vs 0.79999999 after 24 steps),
# so AnimationPlayer's LOOP_LINEAR wrap (next_pos > len, then fposmod) never
# fires and the wrap tick sits at position ~= length: the last frame shows
# twice and the loop's first frame is skipped (body_walk Flash 24, 25, 25, 3
# instead of 24, 25, 2, 3). Flash wraps on that tick, so a step that lands
# within LOOP_SNAP of the end of a looping animation is lengthened to end
# LOOP_OVERSHOOT past it: the player's own wrap runs (the looped flag, the
# method keys of both sides of the seam fire as on any wrap) and the position
# restarts at ~LOOP_OVERSHOOT (3e-4 of a frame, under get_current_frame's
# 1e-4-frame floor bias by far).
const LOOP_SNAP := 1e-4        # seconds (0.003 frame)
const LOOP_OVERSHOOT := 1e-5   # seconds


func _tick_step() -> float:
	## The advance() delta for one Flash frame (see LOOP_SNAP).
	var step := 1.0 / FPS
	var an := _anim_player.current_animation
	if an == "" or not _anim_player.has_animation(an):
		return step
	var anim := _anim_player.get_animation(an)
	if anim.loop_mode != Animation.LOOP_LINEAR:
		return step
	var sp := _anim_player.get_playing_speed()
	if sp <= 0.0:
		return step
	var pos := _anim_player.current_animation_position
	var nxt := pos + step * sp
	var alen := float(anim.length)
	if nxt <= alen and nxt > alen - LOOP_SNAP:
		return (alen - pos + LOOP_OVERSHOOT) / sp
	return step


func _process_tick_driven(delta: float) -> void:
	## _process of a tick-driven rig: nothing to advance on a frame the driver
	## claimed (only the idempotent per-frame work, so a driver write after its
	## advance shows this frame); else the self-advance rule.
	if _driver_frame == Engine.get_process_frames():
		_rig_process(0.0)
		for node in _child_overrides:
			if is_instance_valid(node):
				_apply_child_override(node, _child_overrides[node])
		return
	for i in _self_ticks(delta):
		_tick_once()


func _self_ticks(delta: float) -> int:
	## World.ticks when the World autoload runs, else the own accumulator.
	var w := _world_node()
	if w != null and "ticks" in w:
		return maxi(int(w.get("ticks")), 0)
	_self_acc += minf(delta * FPS, 3.0)
	var n := floori(_self_acc + 0.1)
	_self_acc -= n
	return maxi(n, 0)


func _sync_ct_brightness_bones() -> void:
	## The ct_brightness half of _process (a non-zero colour offset).
	if not _ct_offset_active:
		return
	for bone_name: String in _bone_materials:
		var bone: Node2D = _bones.get(bone_name)
		if bone == null:
			continue
		var br: float = bone.modulate.r
		for mat: ShaderMaterial in _bone_materials[bone_name]:
			mat.set_shader_parameter("ct_brightness", br)


func _check_facing() -> void:
	## R3 #7 (Step 16.1): Unit.setVisPos writes `vis.scale.x = storona`
	## (Unit.as:1604, unit.gd setVisPos) without set_facing; the rig follows the
	## sign of its own scale.x here (every rig, every frame and tick), so
	## _rig_on_facing_changed — the player's PipBuck side (UnitPlayer.as:3000,
	## `if (vis.scaleX > 0)`) — is current before _rig_process runs.
	var right := scale.x >= 0.0
	if right != _facing_seen:
		_facing_seen = right
		_rig_on_facing_changed(right)


func _resolve_paths() -> void:
	## Scene root metadata first (generic rigs), then the subclass defaults.
	var defaults := _default_paths()
	data_dir = str(get_meta("data_dir", defaults.get("data_dir", "")))
	art_dir = str(get_meta("art_dir", defaults.get("art_dir", "")))
	anim_library = str(get_meta("anim_library", defaults.get("anim_library", "")))
	if not data_dir.ends_with("/"):
		data_dir += "/"
	if not art_dir.ends_with("/"):
		art_dir += "/"


func _idle_animation() -> String:
	## Scene metadata, then index.json rig block, then the subclass default,
	## then the first state with an animation.
	var idle := str(get_meta("idle_animation", ""))
	if idle == "":
		idle = str(_index.get("rig", {}).get("idle_animation", ""))
	if idle == "":
		idle = _rig_default_idle()
	if idle == "":
		for state: Dictionary in _animation_states:
			if str(state.get("animation", "")) != "":
				idle = str(state["animation"])
				break
	return idle


func _state_label_of(anim_name: String) -> String:
	for state: Dictionary in _animation_states:
		if str(state.get("animation", "")) == anim_name:
			return str(state["label"])
	return ""


# =============================================================================
# Data loading — split files
# =============================================================================

static func _load_json(path: String) -> Variant:
	var f := FileAccess.open(path, FileAccess.READ)
	if f == null:
		push_error("rig_base: failed to open: " + path)
		return {}
	var text := f.get_as_text()
	f.close()
	var parsed: Variant = JSON.parse_string(text)
	if parsed == null:
		push_error("rig_base: cannot parse JSON: " + path)
		return {}
	return parsed


func _load_data() -> void:
	## Load the split manifest files from data_dir. Small files stay in
	## memory; animations are in the pre-built .tres library.
	_index = _load_json(data_dir + "index.json")
	_hierarchy = _load_json(data_dir + "hierarchy.json")
	var states: Variant = _load_json(data_dir + "state_machine.json")
	_animation_states = states if states is Array else []

	_color_channels = _index.get("color_channels", {})
	_default_colors = _index.get("default_colors", {})
	_bone_alt_libs = _index.get("precomputed", {}).get("bone_alt_libs", {})

	for bp_name: String in _index.get("symbols", []):
		_body_parts[bp_name] = _load_json(data_dir + "symbols/" + bp_name + ".json")

	for bp_name: String in _body_parts:
		var children: Array = _body_parts[bp_name].get("children", [])
		if not children.is_empty():
			_nested_hierarchies[bp_name] = children

	_png_meta = _load_json(art_dir + "png_metadata.json")


func _load_texture_by_name(tex_name: String) -> void:
	## Load one raster of the rig (art_dir/<name>.png) into the cache; a name
	## without a PNG is cached as null so it is looked up once.
	if tex_name in _textures:
		return
	var path := art_dir + tex_name + ".png"
	_textures[tex_name] = load(path) if ResourceLoader.exists(path) else null


func _texture(tex_name: String) -> Texture2D:
	## The raster `tex_name`, loaded on first use (lazy loading: a rig holds
	## only what it has shown; preload_all_textures loads everything first).
	if not _textures.has(tex_name):
		_load_texture_by_name(tex_name)
	return _textures.get(tex_name)


func get_texture_stats() -> Dictionary:
	## {loaded: textures held, bytes: their RGBA8 size with mipmaps (4/3),
	## named: rasters the symbol tables name} — for the galleries and tests.
	var loaded := 0
	var bytes := 0
	for tex_name: String in _textures:
		var tex: Texture2D = _textures[tex_name]
		if tex == null:
			continue
		loaded += 1
		bytes += int(tex.get_width() * tex.get_height() * 4 * 4 / 3)
	return {"loaded": loaded, "bytes": bytes, "named": _named_texture_count()}


func _named_texture_count() -> int:
	var names: Dictionary = {}
	for tex_name: String in _texture_names():
		names[tex_name] = true
	return names.size()


func _texture_names() -> Array[String]:
	## Every raster the symbol tables name: artwork elements, leaf frames,
	## mask apertures, bitmaps, timeline masks.
	var out: Array[String] = []
	for lib_name: String in _body_parts:
		var bp: Dictionary = _body_parts[lib_name]
		for layer_data: Dictionary in bp.get("artwork_layers", []):
			for key: String in layer_data.get("element_svg_files", {}):
				for svg_file: String in layer_data["element_svg_files"][key]:
					out.append(svg_file.replace(".svg", ""))
		var svg_files: Dictionary = bp.get("svg_files", {})
		for key: String in svg_files:
			out.append(str(svg_files[key]).replace(".svg", ""))
		var mask_files: Dictionary = bp.get("mask_svg_files", {})
		for key: String in mask_files:
			out.append(str(mask_files[key]).replace(".svg", ""))
		var bitmaps: Array = bp.get("bitmaps", [])
		for bi in range(bitmaps.size()):
			var bm: Dictionary = bitmaps[bi]
			out.append("%s_L%d_B%d" % [lib_name, int(bm.get("layer_index", 0)), bi])
	for source: String in _index.get("timeline_masks", {}):
		for tm: Dictionary in _index["timeline_masks"][source]:
			for kf: Array in tm.get("keyframes", []):
				out.append(str(kf[2]))
	return out


func _load_textures() -> void:
	## Every raster the symbol tables name (preload_all_textures): artwork
	## elements, leaf frames, mask apertures, bitmaps, timeline masks.
	for tex_name: String in _texture_names():
		_load_texture_by_name(tex_name)


# =============================================================================
# Animation player (created from script to avoid Godot editor instancing clash)
# =============================================================================

func _create_animation_player() -> void:
	## The AnimationPlayer is created here (not in the .tscn) and loads the
	## AnimationLibrary written by tools/manifest2tres.py; the library file is
	## the one dependable handle in an export (DirAccess listings of res://
	## are not).
	_anim_player = AnimationPlayer.new()
	_anim_player.name = "AnimationPlayer"
	# C1 (Step 10.1, 2026-10-04): METHOD keys fire IMMEDIATE, inside the
	# player's update, as Flash runs a frame script when the playhead enters
	# the frame, before drawing. DEFERRED (the default) let a finished
	# section's last-frame keys land after _start_anim of the section its
	# `next` chains to: vendor stay -> move1 showed 6 swapped sprites on the
	# chain frame and 2,474 differing pixels on the next; IMMEDIATE 0 px /
	# 0 nodes on all three frames (10_units_weapons/analysis/probe_2026-10-04/
	# chain_probe.gd). IMMEDIATE does not report a missing method: the
	# load-time scan _check_method_keys() is the only signal.
	_anim_player.callback_mode_method = AnimationMixer.ANIMATION_CALLBACK_MODE_METHOD_IMMEDIATE
	if _tick_driven:   # set_tick_driven(true) before _ready (Step 16.1)
		_idle_process_mode = _anim_player.callback_mode_process
		_anim_player.callback_mode_process = AnimationMixer.ANIMATION_CALLBACK_MODE_PROCESS_MANUAL
	var lib: AnimationLibrary = load(anim_library) if anim_library != "" else null
	if lib == null:
		push_error("rig_base: cannot load animation library '%s'" % anim_library)
		lib = AnimationLibrary.new()
	_anim_player.add_animation_library("", lib)
	_anim_player.animation_finished.connect(_on_animation_finished)
	# The graphic frames depend on the animation position: recompute them
	# right after the player applied its values (independent of the tree
	# processing order of the rig and its player).
	_anim_player.mixer_applied.connect(_update_graphic_frames)
	_osn = get_node_or_null("osn")
	(_osn if _osn else self).add_child(_anim_player)
	_check_method_keys(lib)


func _check_method_keys(lib: AnimationLibrary) -> void:
	## C1 rider (ii): every METHOD key must name a method of its target (the
	## rig root: track path ".." from the player's root node `osn`). IMMEDIATE
	## calls a missing method silently, so this scan reports each
	## (animation, method) once per library and process; the replay in
	## _fire_method_keys_up_to skips them (has_method).
	var key := lib.resource_path if lib.resource_path != "" else str(lib.get_instance_id())
	if _checked_libraries.has(key):
		return
	_checked_libraries[key] = true
	var rig_name := scene_file_path.get_file().get_basename() if scene_file_path != "" else str(name)
	var root_node: Node = _anim_player.get_node_or_null(_anim_player.root_node)
	for anim_name in lib.get_animation_list():
		var anim: Animation = lib.get_animation(anim_name)
		var reported := {}
		for i in anim.get_track_count():
			if anim.track_get_type(i) != Animation.TYPE_METHOD:
				continue
			var target: Node = root_node.get_node_or_null(anim.track_get_path(i)) if root_node else null
			for k in anim.track_get_key_count(i):
				var method := str(anim.method_track_get_name(i, k))
				if reported.has(method) or (target != null and target.has_method(method)):
					continue
				reported[method] = true
				push_error("rig_base: %s: animation %s calls missing method %s" % [rig_name, anim_name, method])


# =============================================================================
# Node discovery
# =============================================================================

func _find_body() -> CanvasItem:
	## The bones' container: osn/body (label-timeline rigs), body, or the first
	## CanvasGroup under osn/root.
	for path in ["osn/body", "body"]:
		var n := get_node_or_null(path)
		if n is CanvasItem:
			return n
	var scope: Node = _osn if _osn else self
	for child in scope.get_children():
		if child is CanvasGroup:
			return child
	push_error("rig_base: no body container in the scene")
	return self


func _discover_nodes() -> void:
	_body = _find_body()

	# Map hierarchy bones (use pre-disambiguated node_name from hierarchy.json)
	for bone: Dictionary in _hierarchy.get("bones", []):
		var node_name: String = bone.get("node_name", _strip_lib_prefix(bone["library_item"]))
		_bone_lib[node_name] = _strip_lib_prefix(bone["library_item"])
		_bone_default_lib[node_name] = _bone_lib[node_name]
		# The XFL instance name a frame script or a driver addresses
		# (`sleg1.mark`, `puha`); `named` marks the instance that carries it
		# explicitly (the far leg among two `sleg1`).
		var inst := str(bone.get("instance_name", node_name))
		_bones_by_instance.get_or_add(inst, []).append(
				{"node": node_name, "named": bool(bone.get("named", false)),
				"graphic": bool(bone.get("graphic", false))})

	# Discover bone Node2D children
	for child in _body.get_children():
		if child is Node2D and child is not Sprite2D and child is not AnimationPlayer:
			_bones[child.name] = child
			_discover_nested_children(child, child.name)

	# Root-level attachments: siblings of osn under the rig root at scale 1
	# (metadata/attachment); older scenes put them under osn.
	var scopes: Array = get_children()
	if _osn:
		scopes += _osn.get_children()
	for child in scopes:
		if child is Node2D and child.has_meta("attachment"):
			var att_name := str(child.get_meta("attachment"))
			var key := "@" + att_name
			var lib := str(child.get_meta("library", ""))
			_attachments[att_name] = child
			_bone_lib[key] = lib
			_bone_default_lib[key] = lib
			_discover_nested_children(child, key)

	_assign_instance_names()


func _assign_instance_names() -> void:
	## Give every nested entry the XFL instance name and the graphic flag of
	## the symbol child it was generated from (symbols/<vis_lib>.json
	## `children[].instance` / `graphic`), matched by library, layer and
	## frame span under the same parent; the scene carries no instance names.
	var claimed: Dictionary = {}
	for entry: Dictionary in _nested:
		entry["instance"] = ""
		entry["graphic"] = false
		var bp: Dictionary = _body_parts.get(entry["vis_lib"], {})
		var parent: Node = entry["node"].get_parent()
		if _is_mask_container(parent):
			parent = parent.get_parent()
		var k := 0
		for child: Dictionary in bp.get("children", []):
			var key := "%d#%d" % [parent.get_instance_id(), k]
			k += 1
			if claimed.has(key):
				continue
			if str(child.get("library", "")) != str(entry["library"]):
				continue
			if int(child.get("layer_index", -1)) != int(entry["layer_index"]):
				continue
			if int(child.get("frame_start", 0)) != int(entry["frame_start"]) \
					or int(child.get("frame_end", 0)) != int(entry["frame_end"]):
				continue
			claimed[key] = true
			entry["instance"] = str(child.get("instance", ""))
			entry["graphic"] = bool(child.get("graphic", false))
			if entry["graphic"]:
				# Flash graphic playback per keyframe: entry-level loop /
				# first_frame, graphic_keys {keyframe: [ff, loop]} where a
				# later keyframe differs (see _graphic_child_frame).
				entry["loop"] = str(child.get("loop", "loop"))
				entry["first_frame"] = int(child.get("first_frame", 0))
				entry["graphic_keys"] = child.get("graphic_keys", {})
			break


func _discover_nested_children(parent: Node2D, bone_name: String) -> void:
	for sub in parent.get_children():
		if sub.has_meta("artwork_layer"):
			continue
		if sub.has_meta("mask_part") and not sub.has_meta("library"):
			# Mask clip container — recurse into its children but don't register it
			_discover_nested_children(sub, bone_name)
			continue
		if not sub.has_meta("library"):
			continue
		var ranges_raw: PackedInt32Array = sub.get_meta("frame_ranges", PackedInt32Array())
		var frame_ranges: Array = []
		for ri in range(0, ranges_raw.size(), 2):
			frame_ranges.append(Vector2i(ranges_raw[ri], ranges_raw[ri + 1]))
		if frame_ranges.is_empty():
			frame_ranges.append(Vector2i(sub.get_meta("frame_start"), sub.get_meta("frame_end")))
		var is_container := sub is Node2D and sub is not Sprite2D

		# Parse pre-decomposed frame transform overrides (stored as JSON
		# string): keyframe starts and the baked frames of classic tweens
		# (extract_symbols.py), looked up exactly, then by range start.
		var frame_transforms: Dictionary = {}
		var ft_str: String = sub.get_meta("frame_transforms", "")
		if ft_str != "":
			var parsed: Variant = JSON.parse_string(ft_str)
			if parsed is Dictionary:
				for fkey: String in parsed:
					var ft: Dictionary = parsed[fkey]
					frame_transforms[fkey] = {
						"position": Vector2(float(ft["tx"]), float(ft["ty"])),
						"rotation": float(ft["rot"]),
						"scale": Vector2(float(ft["sx"]), float(ft["sy"])),
						"skew": float(ft["skew"]),
					}
		# Per-frame alphaOffset (keyframes and tweens, extract_symbols.py
		# `frame_alpha`); the node's own alpha_offset is the first keyframe's.
		var frame_alpha: Dictionary = {}
		var fa_str: String = sub.get_meta("frame_alpha", "")
		if fa_str != "":
			var parsed_a: Variant = JSON.parse_string(fa_str)
			if parsed_a is Dictionary:
				for fkey: String in parsed_a:
					frame_alpha[fkey] = float(parsed_a[fkey])

		_nested.append({
			"node": sub,
			"library": sub.get_meta("library"),
			"frame_start": sub.get_meta("frame_start"),
			"frame_end": sub.get_meta("frame_end"),
			"frame_ranges": frame_ranges,
			"vis_lib": sub.get_meta("vis_lib"),
			"layer_index": int(sub.get_meta("layer_index", -1)),
			"bone_name": bone_name,
			"is_container": is_container,
			"frame_transforms": frame_transforms,
			"frame_alpha": frame_alpha,
			"default_alpha_offset": float(sub.get_meta("alpha_offset", 0.0)),
			"default_position": sub.position,
			"default_rotation": sub.rotation,
			"default_scale": sub.scale,
			"default_skew": sub.skew,
		})
		if is_container:
			_discover_nested_children(sub, bone_name)


func _apply_nested_frame_transform(entry: Dictionary, current_frame: int) -> void:
	## Apply the per-frame transform of a nested child at its container's
	## frame: the frame itself when it is keyed (a baked classic-tween frame,
	## extract_symbols.py), else the start of the frame range (keyframe)
	## holding it, else the default (first keyframe) transform. The
	## per-frame alphaOffset (frame_alpha) follows the same lookup.
	var ft: Dictionary = entry["frame_transforms"]
	var range_start := -1
	for r: Vector2i in entry["frame_ranges"]:
		if r.x <= current_frame and current_frame <= r.y:
			range_start = r.x
			break
	var key := str(current_frame)
	if not ft.has(key):
		key = str(range_start)
	var fa: Dictionary = entry.get("frame_alpha", {})
	if not fa.is_empty():
		var akey := str(current_frame) if fa.has(str(current_frame)) else str(range_start)
		var aoff: float = float(fa.get(akey, entry.get("default_alpha_offset", 0.0)))
		(entry["node"] as CanvasItem).modulate.a = clampf(1.0 + aoff / 255.0, 0.0, 1.0)
	if ft.has(key):
		var tf: Dictionary = ft[key]
		entry["node"].position = tf["position"]
		entry["node"].rotation = tf["rotation"]
		entry["node"].scale = tf["scale"]
		entry["node"].skew = tf["skew"]
	else:
		_reset_nested_transform(entry)


func _reset_nested_transform(entry: Dictionary) -> void:
	entry["node"].position = entry["default_position"]
	entry["node"].rotation = entry["default_rotation"]
	entry["node"].scale = entry["default_scale"]
	entry["node"].skew = entry["default_skew"]


func _discover_element_sprites() -> void:
	## Find all per-element artwork sprites (spr_L{n}_S{m}) throughout the hierarchy.
	for bone_name: String in _bones:
		var bone: Node2D = _bones[bone_name]
		var lib: String = _bone_lib.get(bone_name, "")
		_scan_element_sprites(bone, lib, bone_name)
	for att_name: String in _attachments:
		var key := "@" + att_name
		_scan_element_sprites(_attachments[att_name], _bone_lib.get(key, ""), key)


func _scan_element_sprites(parent: Node2D, parent_lib: String, bone_name: String) -> void:
	for child in parent.get_children():
		if child is Sprite2D and child.has_meta("artwork_layer"):
			var entry := {
				"sprite": child,
				"lib": parent_lib,
				"layer_index": int(str(child.get_meta("artwork_layer"))),
				"element_index": int(str(child.get_meta("element_index", 0))),
				"bone_name": bone_name,
			}
			_element_sprites.append(entry)
			_bone_element_sprites.get_or_add(bone_name, []).append(entry)
		elif child is Sprite2D and child.has_meta("bitmap"):
			_bitmap_sprites.append({"sprite": child, "png": str(child.get_meta("bitmap"))})
		elif child is Node2D and child is not Sprite2D and child.has_meta("library"):
			_scan_element_sprites(child, str(child.get_meta("library")), bone_name)
		elif _is_mask_container(child):
			# mask_clip holds artwork sprites of the same symbol
			_scan_element_sprites(child, parent_lib, bone_name)


static func _is_mask_container(node: Node) -> bool:
	## The mask_clip Node2D generated for a symbol with a Flash mask layer:
	## carries mask_part but no library metadata.
	return node is Node2D and node is not Sprite2D \
		and node.has_meta("mask_part") and not node.has_meta("library")


static func _container_artwork_sprites(container: Node) -> Array[Sprite2D]:
	## Artwork sprites (spr_L*_S*) of a container, including those the scene
	## generator parented under its mask_clip.
	var result: Array[Sprite2D] = []
	for child in container.get_children():
		if child is Sprite2D and child.has_meta("artwork_layer"):
			result.append(child)
		elif _is_mask_container(child):
			for sub in child.get_children():
				if sub is Sprite2D and sub.has_meta("artwork_layer"):
					result.append(sub)
	return result


func _is_alt_lib_child(bone_name: String, vis_lib: String) -> bool:
	## True when vis_lib is a library of this bone other than the one it shows
	## now (mane_run children while the bone shows mane, fleg3 while fleg3a...).
	## Children of nested containers have their container as vis_lib and are
	## never alt-library children.
	var current: String = _bone_lib.get(bone_name, "")
	if vis_lib == current:
		return false
	if vis_lib == _bone_default_lib.get(bone_name, ""):
		return true
	for alt: String in _bone_alt_libs.get(bone_name, []):
		if _strip_lib_prefix(alt) == vis_lib:
			return true
	return false


# =============================================================================
# Masks (Flash mask layers -> color_transform_masked.gdshader)
# =============================================================================

func _setup_masks() -> void:
	## Set up shader-based clipping for every sprite the scene generator
	## marked is_masked. Uses color_transform_masked.gdshader instead of
	## clip_children (Godot bug #85243: clip_children doesn't work inside
	## CanvasGroup). The mask itself is never drawn — Flash renders only what
	## it clips.
	_masked_sprites.clear()
	for child in _body.get_children():
		_find_and_setup_shader_masks(child)
	if not _masked_sprites.is_empty():
		_set_mask_frame(0)


func _find_and_setup_shader_masks(node: Node) -> void:
	if node is Sprite2D and node.has_meta("is_masked") and node.material is ShaderMaterial:
		_mask_part_name = str(node.get_meta("mask_part", ""))
		_masked_sprites.append({"sprite": node, "mat": node.material})
	for child in node.get_children():
		_find_and_setup_shader_masks(child)


func _set_mask_frame(frame: int) -> void:
	## Select the mask aperture of `frame` (the masked symbol's frame; the
	## player's eye style) on every masked sprite and refresh the UV mapping.
	var suffix := "" if frame == 0 else "_f%d" % frame
	var mask_tex_name := "%s_mask%s" % [_mask_part_name, suffix]
	var mask_tex: Texture2D = _texture(mask_tex_name)
	if mask_tex == null:
		return
	var mask_meta: Dictionary = _png_meta.get(mask_tex_name + ".png", {})
	if not mask_meta.is_empty():
		# viewBox in the masked symbol's px: the space of mask_clip's children.
		_mask_origin = Vector2(float(mask_meta["vx"]), float(mask_meta["vy"]))
		_mask_extent = Vector2(float(mask_meta["vw"]), float(mask_meta["vh"]))
	for entry: Dictionary in _masked_sprites:
		(entry["mat"] as ShaderMaterial).set_shader_parameter("mask_texture", mask_tex)
	_recompute_mask_uv()


func _recompute_mask_uv() -> void:
	## mask_uv = mask_uv_xform * UV + mask_uv_offset maps each masked
	## sprite's texture UV to the mask texture UV, through the sprite's full
	## local transform (position, rotation, skew, scale). Sprite local px =
	## offset + UV * tex_size (centered = false); parent px = transform *
	## local; mask UV = (parent px - mask viewBox origin) / mask viewBox size.
	for entry: Dictionary in _masked_sprites:
		var spr: Sprite2D = entry["sprite"]
		if spr.texture == null:
			continue
		var tex_size := Vector2(spr.texture.get_width(), spr.texture.get_height())
		var xf := spr.transform
		var col_x := xf.x * tex_size.x / _mask_extent
		var col_y := xf.y * tex_size.y / _mask_extent
		var origin := (xf * spr.offset - _mask_origin) / _mask_extent
		var mat: ShaderMaterial = entry["mat"]
		mat.set_shader_parameter("mask_uv_xform", Transform2D(col_x, col_y, Vector2.ZERO))
		mat.set_shader_parameter("mask_uv_offset", origin)


# =============================================================================
# Timeline masks (a mask layer on a self timeline: turret osn0, vendor bar)
#
# Flash places the mask layer's keyframe shape with a clip depth over the
# masked layers: on frames where the mask layer has content the masked
# bones are clipped to that shape (in the timeline's space, i.e. the body
# container's), on frames where it is empty nothing is clipped. The eye's
# machinery is reused: every Sprite2D under a masked bone gets its own
# color_transform_masked.gdshader material (colour uniforms copied from the
# scene material) and, before each draw, the mask raster of the keyframe
# covering the current source frame (<source>_M<layer>_F<k>.png) with
# mask_uv_xform/mask_uv_offset computed from the sprite's transform
# relative to the body -- so bone keys, nested tweens, tickers and driver
# writes are all followed. Off-mask frames get an open clip (1x1 white).
# Sprites with a blend shader (screen/lighten/hardlight flares) keep it and
# are not clipped (color_transform_masked has no blend variant).
# =============================================================================

func _setup_timeline_masks() -> void:
	var tm: Dictionary = _index.get("timeline_masks", {})
	if tm.is_empty():
		return
	var img := Image.create(1, 1, false, Image.FORMAT_RGBA8)
	img.fill(Color(1, 1, 1, 1))
	_tl_mask_open = ImageTexture.create_from_image(img)
	var shader: Shader = load(_MASKED_SHADER_PATH)
	for source: String in tm:
		for m: Dictionary in tm[source]:
			var sprites: Array = []
			var skipped := 0
			for bone_name: String in m.get("masked_bones", []):
				var bone: Node2D = _bones.get(bone_name)
				if bone == null:
					continue
				for spr: Sprite2D in _sprites_under(bone):
					var old: Material = spr.material
					if not (old is ShaderMaterial) or (old as ShaderMaterial).shader == null \
							or not (old as ShaderMaterial).shader.resource_path.ends_with("/color_transform.gdshader"):
						skipped += 1
						continue
					var mat := ShaderMaterial.new()
					mat.shader = shader
					for param in ["ct_multiply", "ct_offset", "ct_brightness", "footprint"]:
						var v: Variant = (old as ShaderMaterial).get_shader_parameter(param)
						if v != null:
							mat.set_shader_parameter(param, v)
					spr.material = mat
					sprites.append({"sprite": spr, "mat": mat})
			var entry := {"source": source, "layer": int(m.get("mask_layer", -1)),
					"keyframes": m.get("keyframes", []), "sprites": sprites,
					"skipped": skipped, "shown": "?"}
			_tl_masks.append(entry)
			_open_timeline_mask(entry)
	if not _tl_masks.is_empty():
		RenderingServer.frame_pre_draw.connect(_update_timeline_masks)


func _exit_tree() -> void:
	if RenderingServer.frame_pre_draw.is_connected(_update_timeline_masks):
		RenderingServer.frame_pre_draw.disconnect(_update_timeline_masks)
	if _world_clocked:
		_unregister_clip()   # D1: the registry holds no node outside the tree


static func _sprites_under(node: Node) -> Array[Sprite2D]:
	var out: Array[Sprite2D] = []
	for child in node.get_children():
		if child is Sprite2D:
			out.append(child)
		out.append_array(_sprites_under(child))
	return out


func _open_timeline_mask(entry: Dictionary) -> void:
	## No clip: an empty mask keyframe (or another source timeline).
	if entry["shown"] == "":
		return
	for it: Dictionary in entry["sprites"]:
		var mat: ShaderMaterial = it["mat"]
		mat.set_shader_parameter("mask_texture", _tl_mask_open)
		mat.set_shader_parameter("mask_uv_xform", Transform2D(Vector2.ZERO, Vector2.ZERO, Vector2.ZERO))
		mat.set_shader_parameter("mask_uv_offset", Vector2(0.5, 0.5))
	entry["shown"] = ""


func get_timeline_mask_state() -> Array:
	## [{source, layer, shown (mask raster name, "" = no clip), sprites,
	## skipped}] -- for the galleries and tests.
	var out: Array = []
	for entry: Dictionary in _tl_masks:
		out.append({"source": entry["source"], "layer": entry["layer"], "shown": entry["shown"],
				"sprites": (entry["sprites"] as Array).size(), "skipped": entry["skipped"]})
	return out


func _update_timeline_masks() -> void:
	## Before each draw: the mask keyframe covering the current source frame
	## and, per clipped sprite, the map from its texture UV to the mask UV
	## (the eye's _recompute_mask_uv with the sprite's transform relative to
	## the body container, the timeline's space).
	if not is_inside_tree() or _body == null:
		return
	var anim := get_current_anim()
	var source := ""
	var sf := 0
	if anim != "":
		var meta := get_anim_meta(anim)
		source = str(meta.get("source", anim))
		sf = int(meta.get("frame_start", 0)) + get_current_frame()
	var body_inv := (_body as Node2D).get_global_transform().affine_inverse()
	for entry: Dictionary in _tl_masks:
		var tex_name := ""
		if entry["source"] == source:
			for kf: Array in entry["keyframes"]:
				if int(kf[0]) <= sf and sf <= int(kf[1]):
					tex_name = str(kf[2])
					break
		var tex: Texture2D = _texture(tex_name) if tex_name != "" else null
		var meta_png: Dictionary = _png_meta.get(tex_name + ".png", {}) if tex != null else {}
		if tex == null or meta_png.is_empty():
			_open_timeline_mask(entry)
			continue
		var origin := Vector2(float(meta_png["vx"]), float(meta_png["vy"]))
		var extent := Vector2(float(meta_png["vw"]), float(meta_png["vh"]))
		for it: Dictionary in entry["sprites"]:
			var spr: Sprite2D = it["sprite"]
			if spr.texture == null:
				continue
			var tex_size := Vector2(spr.texture.get_width(), spr.texture.get_height())
			var xf := body_inv * spr.get_global_transform()
			var mat: ShaderMaterial = it["mat"]
			if entry["shown"] != tex_name:
				mat.set_shader_parameter("mask_texture", tex)
			mat.set_shader_parameter("mask_uv_xform",
					Transform2D(xf.x * tex_size.x / extent, xf.y * tex_size.y / extent, Vector2.ZERO))
			mat.set_shader_parameter("mask_uv_offset", (xf * spr.offset - origin) / extent)
		entry["shown"] = tex_name


# =============================================================================
# Texture application
# =============================================================================

func _apply_all_textures() -> void:
	# Per-element artwork sprites — apply frame 0 texture to each element
	for entry: Dictionary in _element_sprites:
		var lib: String = entry["lib"]
		var bp: Dictionary = _body_parts.get(lib, {})
		var armor_labels: Dictionary = bp.get("armor_labels", {})
		var elem_svgs := _get_element_svgs(lib, entry["layer_index"])
		if elem_svgs.is_empty():
			continue
		# Skip variant parts with no frame-0 art
		if not armor_labels.is_empty() and not elem_svgs.has("0"):
			continue
		var frame_key := "0"
		if not elem_svgs.has(frame_key):
			frame_key = elem_svgs.keys()[0]
		var elem_list: Array = elem_svgs[frame_key]
		var si: int = entry["element_index"]
		if si < elem_list.size():
			_apply_texture(entry["sprite"], str(elem_list[si]).replace(".svg", ""))
		else:
			entry["sprite"].visible = false

	# Nested children — containers have element sprites, leaves are Sprite2D directly
	for entry: Dictionary in _nested:
		var lib: String = entry["library"]
		var bp: Dictionary = _body_parts.get(lib, {})
		if entry.get("is_container", false):
			for al: Dictionary in bp.get("artwork_layers", []):
				var li: int = int(al["layer_index"])
				var elem_svgs: Dictionary = al.get("element_svg_files", {})
				if elem_svgs.is_empty():
					continue
				var armor_labels: Dictionary = bp.get("armor_labels", {})
				if not armor_labels.is_empty() and not elem_svgs.has("0"):
					continue
				var frame_key := "0"
				if not elem_svgs.has(frame_key):
					frame_key = elem_svgs.keys()[0]
				var elem_list: Array = elem_svgs[frame_key]
				for child: Sprite2D in _container_artwork_sprites(entry["node"]):
					if int(str(child.get_meta("artwork_layer"))) == li:
						var si: int = int(str(child.get_meta("element_index", 0)))
						if si < elem_list.size():
							_apply_texture(child, str(elem_list[si]).replace(".svg", ""))
						else:
							child.visible = false
		else:
			var svg_files: Dictionary = bp.get("svg_files", {})
			if svg_files.is_empty():
				continue
			var armor_labels: Dictionary = bp.get("armor_labels", {})
			if not armor_labels.is_empty() and not svg_files.has("0"):
				continue
			var svg_file: String = svg_files.get("0", "")
			if svg_file == "":
				svg_file = svg_files.values()[0]
			_apply_texture(entry["node"], svg_file.replace(".svg", ""))

	# Bitmap sprites (copied through by 04.3 at scale 1; the metadata offset
	# carries the bitmap matrix translation)
	for entry: Dictionary in _bitmap_sprites:
		_apply_texture(entry["sprite"], entry["png"])


func _apply_texture(spr: Sprite2D, tex_name: String) -> void:
	var tex: Texture2D = _texture(tex_name)
	if tex == null:
		return
	spr.texture = tex
	# ViewBox offset: position the texture so Flash origin (0,0) = bone origin
	var meta: Dictionary = _png_meta.get(tex_name + ".png", {})
	if not meta.is_empty():
		# Sprite is at scale 1/R, offset is in local (pre-scale) coords
		# visual_offset = offset * (1/R) = (vx, vy) in parent space
		var r: float = float(meta.get("scale", 2.0))
		spr.offset = Vector2(float(meta["vx"]) * r, float(meta["vy"]) * r)


func _get_element_svgs(lib: String, layer_index: int) -> Dictionary:
	## The element_svg_files dict for a specific artwork layer of a symbol:
	## {frame_idx_str: [svg_name, ...]}
	var bp: Dictionary = _body_parts.get(lib, {})
	for al: Dictionary in bp.get("artwork_layers", []):
		if int(al["layer_index"]) == layer_index:
			return al.get("element_svg_files", {})
	return {}


func _swap_nested_texture(lib_name: String, frame: int) -> void:
	## Show `frame` of every nested instance of a library (container element
	## sprites or leaf sprite) and re-apply the per-frame transforms of its
	## children.
	var bp: Dictionary = _body_parts.get(lib_name, {})
	var frame_str := str(frame)
	for entry: Dictionary in _nested:
		if entry["library"] != lib_name:
			continue
		if entry.get("is_container", false):
			for al: Dictionary in bp.get("artwork_layers", []):
				var li: int = int(al["layer_index"])
				var elem_svgs: Dictionary = al.get("element_svg_files", {})
				var elem_list: Array = elem_svgs.get(frame_str, [])
				if elem_list.is_empty():
					elem_list = elem_svgs.get("0", [])
				for child: Sprite2D in _container_artwork_sprites(entry["node"]):
					if int(str(child.get_meta("artwork_layer"))) == li:
						var si: int = int(str(child.get_meta("element_index", 0)))
						if si < elem_list.size():
							_apply_texture(child, str(elem_list[si]).replace(".svg", ""))
							child.visible = true
						else:
							child.visible = false
		else:
			var svg_files: Dictionary = bp.get("svg_files", {})
			var svg_file: String = svg_files.get(frame_str, "")
			if svg_file != "":
				_apply_texture(entry["node"] as Sprite2D, svg_file.replace(".svg", ""))

	for entry: Dictionary in _nested:
		if entry["vis_lib"] != lib_name:
			continue
		if entry["frame_transforms"].is_empty() and entry["frame_alpha"].is_empty():
			continue
		if entry["node"].visible:
			_apply_nested_frame_transform(entry, frame)


func _set_sub_visibility(vis_lib: String, frame: int) -> void:
	## Show/hide the children of a container by their frame ranges against
	## `frame` (a container driven by a runtime frame, not by the timeline).
	for entry: Dictionary in _nested:
		if entry["vis_lib"] != vis_lib:
			continue
		entry["node"].visible = _frame_in_ranges(entry, frame)


static func _frame_in_ranges(entry: Dictionary, frame: int) -> bool:
	for r: Vector2i in entry["frame_ranges"]:
		if r.x <= frame and frame <= r.y:
			return true
	return false


# =============================================================================
# Visibility, label variants
# =============================================================================

func _set_initial_visibility() -> void:
	# Nested children visibility by frame range AND vis_lib match: alt-library
	# children stay hidden while the bone shows its default library.
	for entry: Dictionary in _nested:
		if _is_alt_lib_child(entry["bone_name"], entry["vis_lib"]):
			entry["node"].visible = false
			continue
		_show_child_entry(entry, 0)


func _apply_blend_modes() -> void:
	## Flash blend modes are baked into the scene's materials by
	## manifest2tscn.py. What remains is the instance colour transform: an
	## alphaOffset on straight alpha is approximated by modulate.a =
	## 1 + offset/255, exact for opaque texels.
	for entry: Dictionary in _nested:
		var node: CanvasItem = entry["node"]
		if node.has_meta("alpha_offset"):
			node.modulate.a = clampf(1.0 + float(node.get_meta("alpha_offset")) / 255.0, 0.0, 1.0)


func _lib_current_frame(lib: String) -> int:
	## The frame a container symbol sits on: its label frame for the
	## `armor_labels` symbols (the current variant), else the subclass rule.
	## Children are shown by their frame_ranges against this frame.
	var bp: Dictionary = _body_parts.get(lib, {})
	var armor_labels: Dictionary = bp.get("armor_labels", {})
	if not armor_labels.is_empty():
		var frame_str := _find_armor_frame(armor_labels, _variant_id)
		return int(frame_str) if frame_str != "" else 0
	if _lib_held_frame.has(lib):
		return int(_lib_held_frame[lib])
	return _rig_lib_frame(lib)


func _is_channel_lib(lib: String) -> bool:
	## Instances tinted by Obj.setColor — hidden by Appear.transp (Flash
	## Obj.as:157-160) so the silhouette shows alone.
	for channel_name: String in _color_channels:
		if lib in _color_channels[channel_name]:
			return true
	return false


func _nested_should_show(entry: Dictionary, in_range: bool) -> bool:
	## The runtime gates on top of a child's frame range: transparency, then
	## the subclass gates.
	if not in_range:
		return false
	if _transp and _is_channel_lib(entry["library"]):
		return false
	if _child_hidden.get("%s/%s" % [entry["bone_name"], entry["library"]], false):
		return false
	return _rig_nested_gate(entry)


func _update_nested_visibility() -> void:
	## Show every nested child whose frame range contains its container's
	## current frame, apply its per-frame transform, and hide the
	## alternate-library children until _swap_bone_lib selects them. Runtime
	## gates are applied on top so they survive any re-application.
	for entry: Dictionary in _nested:
		if _is_alt_lib_child(entry["bone_name"], entry["vis_lib"]):
			entry["node"].visible = false
			continue
		_show_child_entry(entry, _container_frame_of(entry))


func _container_frame_of(entry: Dictionary) -> int:
	## The frame the container of a nested child shows: the frame its node
	## was sent to (graphic sync, child_goto, a ticker), else the library's
	## current frame (label variant / held frame / subclass rule).
	var parent: Node = entry["node"].get_parent()
	if _is_mask_container(parent):
		parent = parent.get_parent()
	if _child_frames.has(parent):
		return int(_child_frames[parent])
	return _lib_current_frame(entry["vis_lib"])


func _refresh_nested_entry(entry: Dictionary) -> void:
	## Re-evaluate one child's visibility against its container's frame.
	var current_frame := _container_frame_of(entry)
	entry["node"].visible = _nested_should_show(entry, _frame_in_ranges(entry, current_frame))


func _find_armor_frame(armor_labels: Dictionary, variant_id: String) -> String:
	for idx: String in armor_labels:
		if armor_labels[idx] == variant_id:
			return idx
	return ""


func _apply_variant(variant_id: String) -> void:
	## Select a frame label (Flash `Obj.setArmor`: `gotoAndStop(label)` on every
	## symbol that has `armor_labels`; an unknown label falls back to frame 0
	## as Flash falls back to frame 1): swap every element sprite and nested
	## node texture, then re-evaluate nested visibility.
	_variant_id = variant_id
	for entry: Dictionary in _element_sprites:
		_apply_variant_texture_element(entry, variant_id)
	for entry: Dictionary in _nested:
		if entry.get("is_container", false):
			_apply_variant_textures_container(entry, variant_id)
		else:
			_apply_variant_texture(entry["node"], entry["library"], variant_id)
	_update_nested_visibility()


func _apply_variant_texture(spr: Sprite2D, lib: String, variant_id: String) -> void:
	## Leaf sprite: the label frame's SVG, else frame 0, else no texture.
	var bp: Dictionary = _body_parts.get(lib, {})
	var armor_labels: Dictionary = bp.get("armor_labels", {})
	if armor_labels.is_empty():
		return
	var frame_idx := _find_armor_frame(armor_labels, variant_id)
	var svg_files: Dictionary = bp.get("svg_files", {})
	if frame_idx != "" and svg_files.has(frame_idx):
		_apply_texture(spr, svg_files[frame_idx].replace(".svg", ""))
	elif svg_files.has("0"):
		_apply_texture(spr, svg_files["0"].replace(".svg", ""))
	else:
		spr.texture = null


func _apply_variant_textures_container(entry: Dictionary, variant_id: String) -> void:
	## All element sprites inside a nested container.
	var lib: String = entry["library"]
	var bp: Dictionary = _body_parts.get(lib, {})
	var armor_labels: Dictionary = bp.get("armor_labels", {})
	if armor_labels.is_empty():
		return
	var frame_idx := _find_armor_frame(armor_labels, variant_id)
	if frame_idx == "":
		frame_idx = "0"
	for al: Dictionary in bp.get("artwork_layers", []):
		var li: int = int(al["layer_index"])
		var elem_svgs: Dictionary = al.get("element_svg_files", {})
		if elem_svgs.is_empty():
			continue
		var elem_list: Array = elem_svgs.get(frame_idx, [])
		if elem_list.is_empty():
			elem_list = elem_svgs.get("0", [])
		for child: Sprite2D in _container_artwork_sprites(entry["node"]):
			if int(str(child.get_meta("artwork_layer"))) == li:
				var si: int = int(str(child.get_meta("element_index", 0)))
				if si < elem_list.size():
					_apply_texture(child, str(elem_list[si]).replace(".svg", ""))
					child.visible = true
				else:
					child.texture = null
					child.visible = false


func _apply_variant_texture_element(entry: Dictionary, variant_id: String) -> void:
	## A per-element sprite of a bone, handling variable element counts.
	var lib: String = entry["lib"]
	var bp: Dictionary = _body_parts.get(lib, {})
	var armor_labels: Dictionary = bp.get("armor_labels", {})
	if armor_labels.is_empty():
		return
	var frame_idx := _find_armor_frame(armor_labels, variant_id)
	if frame_idx == "":
		frame_idx = "0"
	var elem_svgs := _get_element_svgs(lib, entry["layer_index"])
	if elem_svgs.is_empty():
		return
	var elem_list: Array = elem_svgs.get(frame_idx, [])
	if elem_list.is_empty():
		elem_list = elem_svgs.get("0", [])
	var si: int = entry["element_index"]
	if si < elem_list.size():
		_apply_texture(entry["sprite"], str(elem_list[si]).replace(".svg", ""))
		entry["sprite"].visible = true
	else:
		entry["sprite"].texture = null
		entry["sprite"].visible = false


func set_transparent(enabled: bool) -> void:
	## Transparency mode (Flash Appear.transp, Obj.as:157-160): every
	## colour-channel instance is hidden, the rest stays. The flag is a gate
	## in _nested_should_show, so variant changes and library switches keep it.
	_transp = enabled
	_update_nested_visibility()


# =============================================================================
# Tickers (self-animating nested symbols)
# =============================================================================

func _add_ticker(id: String, lib: String, sprites: Array, row: Dictionary) -> void:
	## row: {frames: Array[int], loop_from: int (-1 = hold the last frame),
	## idle_frame: int (-1 = leave the texture as is), random_start: [a, b]
	## (optional; 0-based frames a new start is drawn from at activation and
	## at every wrap), scripts: {frame: statement} (optional), target: a
	## resolved child dict (optional; the ticker drives that node's children)}.
	## sprites: [{sprite, kind: "leaf"} | {sprite, kind: "element", layer,
	## element, entry?}] — `entry` (an _element_sprites entry) lets the ticker
	## skip a bone sprite while the bone shows another library.
	var rs: Variant = row.get("random_start", null)
	_tickers.append({
		"id": id, "lib": lib, "sprites": sprites,
		"frames": row["frames"], "loop_from": int(row["loop_from"]),
		"idle_frame": int(row.get("idle_frame", -1)),
		"random_start": rs if (rs is Array and rs.size() == 2) else [],
		"scripts": row.get("scripts", {}),
		"target": row.get("target", null),
		"t": 0.0, "last": -1, "active": false,
	})


func _ticker(id: String) -> Dictionary:
	for t: Dictionary in _tickers:
		if t["id"] == id:
			return t
	return {}


func _setup_index_tickers() -> void:
	## One ticker per index.json `tickers` row (tools: build_index.py derives
	## them from each symbol's own timeline under the display convention),
	## registered on every sprite that shows the library.
	var rows: Dictionary = _index.get("tickers", {})
	var count := 0
	for lib: String in rows:
		var sprites := _sprites_showing_lib(lib)
		if sprites.is_empty() and not _lib_holds_children(lib):
			continue
		_add_ticker(lib, lib, sprites, rows[lib])
		_ticker(lib)["from_index"] = true
		count += 1
	if count > 0:
		print_verbose("[rig_base] Tickers: %d of %d index rows registered (%s)" % [
			count, rows.size(), ", ".join(_ticker_ids())])


func _lib_holds_children(lib: String) -> bool:
	## True when some instance of `lib` holds nested children (vis_lib): a
	## container without artwork of its own (sentinel `ogn`: only the tweened
	## flame `ogn0`) still plays, and its ticker moves those children
	## (_show_lib_children) although it has no sprite to texture.
	for entry: Dictionary in _nested:
		if entry["vis_lib"] == lib:
			return true
	return false


func _sprites_showing_lib(lib: String) -> Array:
	## Every sprite that shows `lib`: the artwork sprites of bones and nested
	## containers of that library (skipping nested graphic instances, which
	## follow their parent in Flash) and the leaf sprites of its nested
	## instances. A bone's sprites are always registered: whether the bone is
	## a graphic is decided per keyframe by the running animation
	## (_bone_graphic; the hierarchy flag is only its idle placement), so
	## _apply_ticker_frame gates them at tick time.
	var items: Array = []
	var graphic_containers: Dictionary = {}
	for entry: Dictionary in _nested:
		if entry.get("graphic", false) and entry.get("is_container", false):
			graphic_containers[entry["node"]] = true
	for es: Dictionary in _element_sprites:
		if es["lib"] != lib and not _bone_shows_lib_later(es, lib):
			continue
		var owner: Node = es["sprite"].get_parent()
		if _is_mask_container(owner):
			owner = owner.get_parent()
		if graphic_containers.has(owner):
			continue
		items.append({"sprite": es["sprite"], "kind": "element",
				"layer": es["layer_index"], "element": es["element_index"], "entry": es,
				"bone": es["bone_name"]})
	for entry: Dictionary in _nested:
		if entry["library"] == lib and not entry.get("is_container", false) \
				and not entry.get("graphic", false) and entry["node"] is Sprite2D:
			items.append({"sprite": entry["node"], "kind": "leaf", "bone": entry["bone_name"]})
	return items


func _bone_shows_lib_later(es: Dictionary, lib: String) -> bool:
	## True when `es` is a bone's own artwork sprite and `lib` is one of the
	## bone's alternate libraries (bone_alt_libs, or its default after a
	## swap): the sprite shows `lib` once _swap_bone_lib selects it, so an
	## index ticker of `lib` registers it now and _apply_ticker_frame gates it
	## by the library the sprite shows at tick time (roller roll1 -> roll2).
	var bone_name: String = es["bone_name"]
	if _strip_lib_prefix(str(es["lib"])) != _strip_lib_prefix(str(_bone_lib.get(bone_name, ""))):
		return false   # a nested container's artwork, not the bone's own
	if _strip_lib_prefix(str(_bone_default_lib.get(bone_name, ""))) == lib:
		return true
	for alt in _bone_alt_libs.get(bone_name, []):
		if _strip_lib_prefix(str(alt)) == lib:
			return true
	return false


func _index_ticker_frame(lib: String) -> int:
	## The frame the active index ticker of `lib` shows now; -1 when the
	## library has no running index ticker.
	for t: Dictionary in _tickers:
		if t.get("from_index", false) and t["active"] and t["lib"] == lib and int(t["last"]) >= 0:
			return int(t["frames"][int(t["last"])])
	return -1


func _under_graphic_instance(entry: Dictionary) -> bool:
	## True when the nested child sits inside a graphic instance: its bone is
	## a graphic in the running animation (_bone_graphic) or a container on
	## the way up to the bone is a nested graphic. Flash: nothing inside a
	## graphic instance plays on its own — it all derives from the parent's
	## frame (the graphic sync owns it, not the tickers).
	if _bone_graphic.has(entry["bone_name"]):
		return true
	var bone_node: Node = _bones.get(entry["bone_name"])
	var p: Node = entry["node"].get_parent()
	while p != null and p != bone_node and p != _body:
		if _is_mask_container(p):
			p = p.get_parent()
			continue
		for other: Dictionary in _nested:
			if other["node"] == p:
				if other.get("graphic", false):
					return true
				break
		p = p.get_parent()
	return false


func _ticker_ids() -> Array[String]:
	var ids: Array[String] = []
	for t: Dictionary in _tickers:
		ids.append(str(t["id"]))
	return ids


func get_ticker_frame(id: String) -> int:
	## The 0-based Flash frame a ticker shows now (-1: unknown ticker or
	## inactive). For the galleries and tests.
	var t := _ticker(id)
	if t.is_empty() or not t["active"] or int(t["last"]) < 0:
		return -1
	return int(t["frames"][int(t["last"])])


func set_rng_seed(seed_value: int) -> void:
	## Seed the rig's random source (ticker random starts) for reproducible runs.
	_rng.seed = seed_value


func _random_ticker_index(t: Dictionary) -> int:
	## Index into `frames` of a start drawn from random_start (falls back to
	## the first frame when the drawn frame is not in the list).
	var rs: Array = t["random_start"]
	var frame := _rng.randi_range(int(rs[0]), int(rs[1]))
	return maxi((t["frames"] as Array).find(frame), 0)


func _restart_ticker(t: Dictionary) -> void:
	## A fresh instance of the ticker's clip (fix 2026-10-05, review B1 (iv)):
	## frame 1 — or a new random start, as the frame-1 script's Math.random()
	## draws again — shown now, the cadence restarted (as activation does).
	t["t"] = 0.0
	var start := 0
	if not (t["random_start"] as Array).is_empty():
		start = _random_ticker_index(t)
		t["t"] = float(start)
	t["last"] = start
	_apply_ticker_frame(t, int(t["frames"][start]))


func _ticker_in_body(t: Dictionary) -> bool:
	## True when the ticker's clip lives under the body (a nested clip of the
	## body_* instance, re-created on a source change); false for the root
	## attachments' tickers (cryst, shit: siblings of osn, one instance for
	## the rig's life). A container without artwork (sentinel `ogn`) is a
	## nested clip of the body.
	if _body == null or _body == self:
		return true
	var target: Variant = t.get("target", null)
	if target is Dictionary and target["node"] is Node:
		return _body.is_ancestor_of(target["node"])
	for item: Dictionary in t["sprites"]:
		if item["sprite"] is Node:
			return _body.is_ancestor_of(item["sprite"])
	return true


func _set_ticker_active(id: String, active: bool) -> void:
	var t := _ticker(id)
	if t.is_empty() or t["active"] == active:
		return
	t["active"] = active
	t["t"] = 0.0
	t["last"] = -1
	if active:
		var start := 0
		if not (t["random_start"] as Array).is_empty():
			start = _random_ticker_index(t)
			t["t"] = float(start)
		t["last"] = start   # get_ticker_frame() is valid from activation on
		_apply_ticker_frame(t, int(t["frames"][start]))
	elif int(t["idle_frame"]) >= 0:
		_apply_ticker_frame(t, int(t["idle_frame"]))


func _apply_ticker_frame(t: Dictionary, frame: int) -> void:
	## Show `frame` of the ticker's library on every registered sprite; a
	## frame without artwork clears the texture. A bone sprite whose bone
	## shows another library now is left alone, and so is every sprite of a
	## bone that is a graphic in the running animation (Flash: a graphic
	## instance has no playhead — the graphic sync owns its frame). The
	## children the library holds on that frame follow (one node for a
	## child_play ticker, every instance for an index ticker).
	if t.is_empty():
		return
	var lib: String = t["lib"]
	var bp: Dictionary = _body_parts.get(lib, {})
	var key := str(frame)
	var from_index: bool = t.get("from_index", false)
	for item: Dictionary in t["sprites"]:
		if item.has("entry") and str(item["entry"].get("lib", "")) != lib:
			continue
		if _bone_graphic.has(str(item.get("bone", ""))):
			continue
		if from_index and _child_frames.has(_ticker_item_node(item)):
			# A node sent to its own frame (child_goto = gotoAndStop, a
			# child_play ticker, the graphic sync) has left the lockstep:
			# Flash stopped / re-targeted that one instance's playhead.
			continue
		var spr: Sprite2D = item["sprite"]
		var svg := ""
		if item["kind"] == "leaf":
			svg = str(bp.get("svg_files", {}).get(key, ""))
		else:
			var elem_list: Array = _get_element_svgs(lib, int(item["layer"])).get(key, [])
			var si: int = int(item["element"])
			if si < elem_list.size():
				svg = str(elem_list[si])
		if svg == "":
			spr.texture = null
		else:
			_apply_texture(spr, svg.replace(".svg", ""))
			if item.has("entry"):
				# an index ticker's artwork sprite hidden for a frame without
				# art (_swap_bone_lib, _show_child_frame) shows again
				spr.visible = true
	var target: Variant = t.get("target", null)
	if target is Dictionary:
		_child_frames[target["node"]] = frame
		_lib_held_frame[lib] = frame
		_show_child_children(target, frame)
	elif t.get("from_index", false):
		_lib_held_frame[lib] = frame
		_show_lib_children(lib, frame)


func _ticker_item_node(item: Dictionary) -> Node:
	## The child node an index-ticker sprite item draws: the leaf sprite
	## itself, else the container (bone or nested container) holding the
	## artwork sprite (through its mask_clip).
	var spr: Node = item["sprite"]
	if item["kind"] == "leaf":
		return spr
	var owner: Node = spr.get_parent()
	if _is_mask_container(owner):
		owner = owner.get_parent()
	return owner


func _advance_tickers(delta: float) -> void:
	var dt := delta * FPS
	for t: Dictionary in _tickers:
		if t["active"]:
			_advance_ticker(t, dt)


func _advance_ticker(t: Dictionary, dt: float) -> void:
	## Step one active ticker by `dt` frames (the per-frame advance, and the
	## elapsed frames of a replayed gotoAndPlay key).
	var frames: Array = t["frames"]
	t["t"] = float(t["t"]) + dt
	var i := int(floor(float(t["t"])))
	var loop_from: int = t["loop_from"]
	if i >= frames.size():
		if loop_from < 0:
			i = frames.size() - 1          # hold the last frame
		elif not (t["random_start"] as Array).is_empty():
			# The wrap point draws a new start (the fractional overflow
			# carries over so the cadence stays at 30 fps).
			var start := _random_ticker_index(t)
			t["t"] = float(start) + (float(t["t"]) - float(frames.size()))
			i = int(floor(float(t["t"])))
			if i >= frames.size():
				i = start
				t["t"] = float(start)
		else:
			var span := frames.size() - loop_from
			i = loop_from + (i - loop_from) % span
	if i != int(t["last"]):
		t["last"] = i
		_apply_ticker_frame(t, int(frames[i]))
		var scripts: Dictionary = t.get("scripts", {})
		var key := str(int(frames[i]))
		if scripts.has(key):
			_on_frame_script(str(scripts[key]))


# =============================================================================
# Colour system
# =============================================================================

func _build_channel_map() -> void:
	for channel_name: String in _color_channels:
		var lib_names: Array = _color_channels[channel_name]
		var materials: Array[ShaderMaterial] = []
		for entry: Dictionary in _element_sprites:
			if entry["lib"] in lib_names and entry["sprite"].material is ShaderMaterial:
				materials.append(entry["sprite"].material)
		for entry: Dictionary in _nested:
			for target: Sprite2D in _get_all_sprites_for_nested(entry):
				if entry["library"] in lib_names and target.material is ShaderMaterial:
					materials.append(target.material)
		_channel_materials[channel_name] = materials


func _build_bone_materials() -> void:
	## Per-bone material map for brightness compensation: every ShaderMaterial
	## in each bone's subtree (element sprites + nested).
	var keys: Array = _bones.keys()
	for att_name: String in _attachments:
		keys.append("@" + att_name)
	for bone_name: String in keys:
		var materials: Array[ShaderMaterial] = []
		for entry: Dictionary in _bone_element_sprites.get(bone_name, []):
			if entry["sprite"].material is ShaderMaterial:
				materials.append(entry["sprite"].material)
		for entry: Dictionary in _nested:
			if entry["bone_name"] != bone_name:
				continue
			for target: Sprite2D in _get_all_sprites_for_nested(entry):
				if target.material is ShaderMaterial:
					materials.append(target.material)
		_bone_materials[bone_name] = materials


func get_channel_list() -> Array[String]:
	var names: Array[String] = []
	for channel_name: String in _color_channels:
		names.append(channel_name)
	return names


func set_channel_color(channel: String, color: Color) -> void:
	## Set a colour channel from a Flash-style RGB colour: mult = c/290 + 35/255
	var mult := Color(
		color.r * 255.0 / COLOR_MAX + COLOR_SHIFT,
		color.g * 255.0 / COLOR_MAX + COLOR_SHIFT,
		color.b * 255.0 / COLOR_MAX + COLOR_SHIFT,
		1.0
	)
	var materials: Array = _channel_materials.get(channel, [])
	for mat: ShaderMaterial in materials:
		_ct_base_of(mat)
		_ct_base_mult[mat] = mult
		_write_ct(mat)


func apply_default_colors() -> void:
	## Reset every colour channel to the rig's Flash defaults
	## (index.json.default_colors) through the multiply formula.
	for channel: String in _default_colors:
		set_channel_color(channel, Color.html(str(_default_colors[channel])))


func set_ct_offset(offset: Color) -> void:
	## Flash `osn.transform.colorTransform` offsets (the player's dieTransform):
	## an additive colour offset on every material of the body, not on the root
	## attachments. When non-zero, _process() syncs ct_brightness from the
	## bone modulate so the offset survives brightness darkening unchanged.
	## The whole-visual transform (set_color_transform) composes over it.
	if _pre_ready(set_ct_offset.bind(offset)): return
	_ct_base_off_active = (offset.r != 0.0 or offset.g != 0.0 or offset.b != 0.0
			or offset.a != 0.0)
	_fx_osn_off = offset
	for bone_name: String in _bone_materials:
		if bone_name.begins_with("@"):
			continue
		for mat: ShaderMaterial in _bone_materials[bone_name]:
			_ct_base_of(mat)
			_ct_base_off[mat] = offset
			_write_ct(mat)
	_sync_ct_brightness()
	_fx_update_post()


func _ct_base_of(mat: ShaderMaterial) -> void:
	## Record a material's base multiply/offset the first time it is touched
	## (the values it carries then: no outer transform is ever written to a
	## material without a recorded base).
	if _ct_base_mult.has(mat):
		return
	var m: Variant = mat.get_shader_parameter("ct_multiply")
	var o: Variant = mat.get_shader_parameter("ct_offset")
	_ct_base_mult[mat] = m if m is Color else Color(1, 1, 1, 1)
	_ct_base_off[mat] = o if o is Color else Color(0, 0, 0, 0)


func _write_ct(mat: ShaderMaterial) -> void:
	## outer after inner: ct_multiply = mult * base, ct_offset = mult *
	## base_offset + offset (Flash concatenates vis's transform over its
	## children's); with no outer transform the base values exactly.
	var bm: Color = _ct_base_mult[mat]
	var bo: Color = _ct_base_off[mat]
	if _fx_post and not _fx_att_mats.has(mat):
		# Step 19.1 (D8): the osn offset and the outer transform are the stack's post-CT
		mat.set_shader_parameter("ct_multiply", bm)
		mat.set_shader_parameter("ct_offset", Color(0, 0, 0, 0) if _ct_base_off_active else bo)
		return
	if not _ct_outer_set:
		mat.set_shader_parameter("ct_multiply", bm)
		mat.set_shader_parameter("ct_offset", bo)
		return
	var m := _ct_outer_mult
	var o := _ct_outer_off
	mat.set_shader_parameter("ct_multiply", Color(bm.r * m.r, bm.g * m.g, bm.b * m.b, bm.a * m.a))
	mat.set_shader_parameter("ct_offset", Color(bo.r * m.r + o.r, bo.g * m.g + o.g,
			bo.b * m.b + o.b, bo.a * m.a + o.a))


func _sync_ct_brightness() -> void:
	## A non-zero offset (osn or whole-visual) needs the brightness sync of
	## _process (the shader pre-divides ct_offset by the bone's modulate);
	## the attachments have no animated bone: 1.
	var outer_off := _ct_outer_set and (_ct_outer_off.r != 0.0 or _ct_outer_off.g != 0.0
			or _ct_outer_off.b != 0.0 or _ct_outer_off.a != 0.0)
	_ct_offset_active = _ct_base_off_active or outer_off
	for bone_name: String in _bone_materials:
		var bone: Node2D = _bones.get(bone_name)
		var br: float = bone.modulate.r if bone and _ct_offset_active else 1.0
		for mat: ShaderMaterial in _bone_materials[bone_name]:
			mat.set_shader_parameter("ct_brightness", br)


func set_color_transform(mult: Color, offset: Color) -> void:
	## Flash `vis.transform.colorTransform = ct` (UnitPlayer.as:422-423 the
	## room's cTransform; Unit.as:1560; Unit.heroTransforms Unit.as:253 with
	## offsets 64/32): the whole visual, the root attachments (`@`) included.
	## Offsets in 0..1 (callers divide ColorTr offsets by 255). Composes over
	## the channel tints and the osn offset (outer after inner, _write_ct);
	## set_channel_color/set_ct_offset recompose while it is set; identity
	## (mult 1, offset 0) restores the base values exactly. The weapon's own
	## vis (`currentWeapon.vis`, unless tip 5) is the caller's.
	if _pre_ready(set_color_transform.bind(mult, offset)): return
	var identity := mult == Color(1, 1, 1, 1) and offset == Color(0, 0, 0, 0)
	for bone_name: String in _bone_materials:
		for mat: ShaderMaterial in _bone_materials[bone_name]:
			_ct_base_of(mat)
	_ct_outer_set = not identity
	_ct_outer_mult = mult
	_ct_outer_off = offset
	for bone_name: String in _bone_materials:
		for mat: ShaderMaterial in _bone_materials[bone_name]:
			_write_ct(mat)
	_sync_ct_brightness()
	_fx_update_post()


func get_color_transform() -> Array:
	## [mult, offset] of the whole-visual transform (identity when unset).
	if _ct_outer_set:
		return [_ct_outer_mult, _ct_outer_off]
	return [Color(1, 1, 1, 1), Color(0, 0, 0, 0)]


func clear_ct_offset() -> void:
	## Reset ct_offset to zero and stop brightness compensation sync.
	set_ct_offset(Color(0, 0, 0, 0))


# =============================================================================
# Animation playback API
# =============================================================================

func set_anim_state(label: String) -> void:
	## Play by state label (Flash `vis.osn.gotoAndStop(label)`; the fresh
	## body instance plays from frame 1). Like the `animState` guard in
	## UnitPlayer.animate(), selecting the state that is already running
	## does nothing (its sections may have chained meanwhile).
	if _pre_ready(set_anim_state.bind(label)): return
	for state: Dictionary in _animation_states:
		if state["label"] == label:
			var anim_name: String = state["animation"]
			if anim_name == "" or not _anim_player.has_animation(anim_name):
				return
			if _current_state == label and _anim_player.assigned_animation != "":
				return
			_current_state = label
			_rig_on_state_entered(label)
			_start_anim(anim_name, 0, false)
			return


## Step 16.5 (16.3 gap 2): a new osn frame is a fresh body instance in Flash
## (`vis.osn.gotoAndStop(label)`): its nested clips start over before the new
## body's frame-1 script runs. Called by set_anim_state when the state changes,
## before the section starts (its frame-0 keys replay the frame-1 script).
func _rig_on_state_entered(_label: String) -> void:
	pass


## Step 16.5 (the 15.4 request): the compiled state table without reading the
## generated files — the section a state label plays ("" when the label is no
## state) and the rig's `index.json` `rig` block (`state_instance`, `state_kind`,
## …). Valid after `_ready` (empty before).
func get_state_animation(label: String) -> String:
	for state: Dictionary in _animation_states:
		if state["label"] == label:
			return str(state["animation"])
	return ""


func get_rig_meta() -> Dictionary:
	var r = _index.get("rig", {})
	return r if r is Dictionary else {}


## Step 16.5 (the 14.4 request, UnitPet's moon): Flash `vis.osn.rotation` read back,
## in radians (0 before `_ready` or without an osn).
func get_osn_rotation() -> float:
	return _osn.rotation if _osn != null else 0.0


func set_anim_state_index(index: int) -> void:
	## Play by state index (position of the label in state_machine.json).
	for state: Dictionary in _animation_states:
		if int(state["index"]) == index:
			set_anim_state(str(state["label"]))
			return


func hold_frame(anim_name: String, frame: int) -> void:
	## Flash `body.gotoAndStop(n)` (0-based frame here): show exactly that
	## frame of the animation and stay there.
	if _pre_ready(hold_frame.bind(anim_name, frame)): return
	if not _anim_player.has_animation(anim_name):
		return
	_current_state = ""
	_start_anim(anim_name, frame, true)


func play_from_frame(anim_name: String, frame: int) -> void:
	## Flash `body.gotoAndPlay(n)` (0-based frame here): play from that frame.
	if _pre_ready(play_from_frame.bind(anim_name, frame)): return
	if not _anim_player.has_animation(anim_name):
		return
	_current_state = ""
	_start_anim(anim_name, frame, false)


func play_anim_from_frame(anim_name: String, frame: int) -> void:
	## Alias of play_from_frame (older name).
	play_from_frame(anim_name, frame)


func play_from_label(label: String) -> bool:
	## Flash `body.gotoAndPlay('label')` inside the current source timeline:
	## plays the section whose metadata/label is `label` and whose source is
	## the current animation's source. Returns false when no such section exists.
	if _pre_ready(play_from_label.bind(label)): return true
	var current := get_current_anim()
	var source := str(get_anim_meta(current).get("source", current))
	for name in _anim_player.get_animation_list():
		var meta := get_anim_meta(name)
		if str(meta.get("label", "")) == label and str(meta.get("source", "")) == source:
			_current_state = ""
			_start_anim(name, 0, false)
			return true
	return false


func hold_last_frame(anim_name: String) -> void:
	## Flash `anim(dey, true)`: `body.gotoAndStop(totalFrames)` — park the
	## animation on its last frame.
	if _pre_ready(hold_last_frame.bind(anim_name)): return
	if not _anim_player.has_animation(anim_name):
		return
	hold_frame(anim_name, get_anim_frame_count(anim_name) - 1)


func get_current_anim() -> String:
	## Name of the animation being played or held (AnimationPlayer clears
	## current_animation while paused or finished; assigned_animation keeps it).
	if _anim_player == null: return ""   # before _ready (the pre-ready rule)
	return _anim_player.assigned_animation


func get_current_frame() -> int:
	## 0-based frame within the current animation (Flash `body.currentFrame`
	## minus one, relative to the section start).
	var anim_name := get_current_anim()
	if anim_name == "":
		return 0
	var frame := int(floor(_anim_player.current_animation_position * FPS + 1e-4))
	return clampi(frame, 0, get_anim_frame_count(anim_name) - 1)


func get_flash_frame() -> int:
	## 1-based Flash frame of the source timeline (`body.currentFrame`):
	## the section's frame_start + the current frame + 1.
	var anim_name := get_current_anim()
	if anim_name == "":
		return 1
	var meta := get_anim_meta(anim_name)
	return int(meta.get("frame_start", 0)) + get_current_frame() + 1


func get_anim_frame_count(anim_name: String) -> int:
	## Frames in the compiled animation (its section length).
	var meta := get_anim_meta(anim_name)
	if meta.has("frame_start") and meta.has("frame_end"):
		return int(meta["frame_end"]) - int(meta["frame_start"]) + 1
	if _anim_player == null: return 0   # before _ready
	var anim: Animation = _anim_player.get_animation(anim_name)
	return int(round(anim.length * FPS)) if anim else 0


func get_flash_total_frames(anim_name: String) -> int:
	## Flash `body.totalFrames` of the source timeline (UnitPlayer.anim():
	## `t_work = totalFrames`), from the compiled metadata.
	return int(get_anim_meta(anim_name).get("flash_total_frames", get_anim_frame_count(anim_name)))


func get_anim_meta(anim_name: String) -> Dictionary:
	## Playback data compiled by 04.1 and stored as resource metadata on the
	## Animation by tools/manifest2tres.py: source, frame_start, frame_end,
	## flash_total_frames, gameplay, label, hold_last, scrub, next
	## ({animation, mode} or {}), initial_libs ({bone: library at the first frame}).
	if _anim_player == null: return {}   # before _ready
	var anim: Animation = _anim_player.get_animation(anim_name)
	if anim == null:
		return {}
	var meta := {}
	for key in anim.get_meta_list():
		meta[str(key)] = anim.get_meta(key)
	return meta


func get_animation_list() -> Array[String]:
	var names: Array[String] = []
	for state: Dictionary in _animation_states:
		names.append(state["label"])
	return names


func get_animation_player() -> AnimationPlayer:
	return _anim_player


func _section_of_source_frame(source: String, flash_frame: int) -> String:
	## The animation (section) of source timeline `source` that holds the
	## 1-based Flash frame, or "".
	var f := flash_frame - 1
	for anim_name in _anim_player.get_animation_list():
		var meta := get_anim_meta(anim_name)
		if str(meta.get("source", "")) != source or not meta.has("frame_start"):
			continue
		if int(meta["frame_start"]) <= f and f <= int(meta.get("frame_end", meta["frame_start"])):
			return anim_name
	return ""


func hold_source_frame(source: String, flash_frame: int) -> bool:
	## Flash `body.gotoAndStop(n)` on a source timeline (`body_stay`,
	## `body_levit`, `body_laz`, `osn0`, ...; UnitPlayer.as:2945 getStayFrame(),
	## the ladder :2806-2815): the section with metadata/source == `source`
	## and frame_start <= n-1 <= frame_end, held at that frame through
	## _start_anim (method tracks do not fire on seek). The exact inverse of
	## get_flash_frame(). False when no section holds the frame.
	if _pre_ready(hold_source_frame.bind(source, flash_frame)): return true
	var anim_name := _section_of_source_frame(source, flash_frame)
	if anim_name == "":
		return false
	_current_state = ""
	_start_anim(anim_name, flash_frame - 1 - int(get_anim_meta(anim_name)["frame_start"]), true)
	return true


func play_source_frame(source: String, flash_frame: int) -> bool:
	## Flash `body.gotoAndPlay(n)` on a source timeline (the levitation
	## frames 51/67/19): as hold_source_frame, playing on (and following
	## the section's `next`).
	if _pre_ready(play_source_frame.bind(source, flash_frame)): return true
	var anim_name := _section_of_source_frame(source, flash_frame)
	if anim_name == "":
		return false
	_current_state = ""
	_start_anim(anim_name, flash_frame - 1 - int(get_anim_meta(anim_name)["frame_start"]), false)
	return true


func get_osn_label() -> String:
	## Flash `vis.osn.currentFrameLabel` (UnitPlayer.as:2673-2674, 2710,
	## 3065): the label of the osn (state) frame, found like get_osn_frame():
	## the state selected by set_anim_state; else the state whose animation
	## is running; else the state whose animation shares the running
	## section's source timeline (a held `body_sit` section is still on the
	## osn frame `stay`); else, on the 61 rigs with no state list (osn is the
	## timeline itself), the running section's metadata/label; else "".
	if _anim_player == null: return ""   # before _ready
	if _current_state != "":
		return _current_state
	var anim_name := get_current_anim()
	if anim_name == "":
		return ""
	var label := _state_label_of(anim_name)
	if label != "":
		return label
	var source := str(get_anim_meta(anim_name).get("source", anim_name))
	for state: Dictionary in _animation_states:
		var a := str(state.get("animation", ""))
		if a != "" and _anim_player.has_animation(a) and str(get_anim_meta(a).get("source", a)) == source:
			return str(state["label"])
	return str(get_anim_meta(anim_name).get("label", ""))


func pause_anim() -> void:
	## Flash `vis.osn.body.stop()` (UnitPlayer.as:2942; GUI.as:1080
	## gg.stopAnim()): freeze the body timeline where it is. The tickers
	## (nested clips) keep running, as Flash's nested clips do under a
	## stopped parent. Idempotent; an entry (_start_anim) clears it.
	if _pre_ready(pause_anim): return
	if _held:
		return
	_held = true
	_anim_player.pause()


func resume_anim() -> void:
	## Flash `vis.osn.body.play()` (UnitPlayer.as:2714-2793): play on from the
	## current position of the assigned animation (also after hold_frame,
	## as Flash's play() after gotoAndStop). Idempotent.
	if _pre_ready(resume_anim): return
	_held = false
	if _anim_player.assigned_animation != "" and not _anim_player.is_playing():
		_anim_player.play()


func is_anim_paused() -> bool:
	## pause_anim() is in force.
	return _held


func has_state(label: String) -> bool:
	## Flash `try { vis.osn.gotoAndStop(label) } catch { gotoAndStop(1) }`
	## (UnitNPC.as:98-103): the label is in the state list, or (the 61 rigs
	## with an empty list, or a list without it) a section's metadata/label.
	for state: Dictionary in _animation_states:
		if str(state.get("label", "")) == label:
			return true
	if label == "":
		return false
	for anim_name in _anim_player.get_animation_list():
		if str(get_anim_meta(anim_name).get("label", "")) == label:
			return true
	return false


func _start_anim(anim_name: String, frame: int, hold: bool) -> void:
	## Common entry: bone order + first-frame libraries, play, seek to the
	## frame (updating immediately), fire the state-changing METHOD keys at
	## or before that time (they do not fire on seek), pause when holding.
	_held = false
	_apply_anim_entry(anim_name)
	_anim_player.play(anim_name)
	var t := maxf(float(frame), 0.0) / FPS
	_anim_player.seek(t, true)
	_fire_method_keys_up_to(anim_name, t)
	if hold:
		_anim_player.pause()
	_update_graphic_frames()


func _fire_method_keys_up_to(anim_name: String, t: float) -> void:
	## Method tracks do not fire on seek: replay the state-changing keys
	## (library switches and the subclass's list) at or before `t`, in track
	## order. Marker keys (labels, stop, goto, bone order) are skipped: the
	## order is applied by _apply_anim_entry and the markers describe the past.
	var anim: Animation = _anim_player.get_animation(anim_name)
	if anim == null:
		return
	var replay := _rig_replay_methods()
	for i in anim.get_track_count():
		if anim.track_get_type(i) != Animation.TYPE_METHOD:
			continue
		for k in anim.track_get_key_count(i):
			# same-frame keys are staggered by 1e-4 s (manifest2tres.py); half a
			# frame of tolerance takes every key of the frame at `t`
			var key_time := anim.track_get_key_time(i, k)
			if key_time > t + 0.5 / FPS:
				break
			var method := str(anim.method_track_get_name(i, k))
			if method in replay and has_method(method):
				# (a missing method was reported by _check_method_keys)
				# A replayed gotoAndPlay child key has been running since its
				# frame: the child's ticker is advanced by the elapsed frames
				# (_child_play_resolved), as the Flash clip would have played on.
				_replay_elapsed_frames = maxf(t - key_time, 0.0) * FPS
				callv(method, anim.method_track_get_params(i, k))
				_replay_elapsed_frames = 0.0


func _apply_anim_entry(anim_name: String) -> void:
	## Everything a METHOD key at t=0 would do, applied explicitly because
	## method tracks do not fire on seek: the bone draw order and the
	## alternate-library set of the animation's first frame. The graphic
	## playback specs belong to the animation: the keys at or before the
	## entry frame re-set them (_fire_method_keys_up_to). A change of source
	## timeline is a new body_* instance in Flash: every nested clip is
	## reset to frame 0 first (sections of one source keep them).
	var source := str(get_anim_meta(anim_name).get("source", anim_name))
	if source != _current_source:
		_reset_child_clips()
		_current_source = source
	_clips_entered = true
	_bone_graphic.clear()
	_apply_bone_order(anim_name)
	var anim: Animation = _anim_player.get_animation(anim_name)
	if anim == null or not anim.has_meta("initial_libs"):
		return
	var libs: Dictionary = anim.get_meta("initial_libs")
	for bone_name: String in libs:
		_swap_bone_lib(bone_name, str(libs[bone_name]))


func _reset_child_clips() -> void:
	## Flash: `osn.gotoAndStop(label)` shows another frame of the state
	## timeline, whose body_* MovieClip is instantiated anew — every nested
	## clip starts at frame 0 (a persisting instance keeps its playhead only
	## across the keyframes of ONE timeline, i.e. the sections of one
	## source). Forget the frame every node under the body was sent to
	## (graphic sync, child_goto, a child_play ticker), drop those tickers
	## and the held frames of their libraries, restart every ticker under
	## the body at its frame 1 (fix 2026-10-05, review B1 (iv): the fresh
	## body_* instance's nested clips start over and a frame-1
	## `gotoAndPlay(Math.floor(Math.random()*K+B))` re-rolls — the player's
	## tail_run strands and wing flap, the NPC blink eyes, the sentinel jets;
	## a label change on the same source keeps them: one persisting instance),
	## then show each affected node again at its library's current frame —
	## the start-up state. The root attachments live outside the body and
	## keep theirs (cryst, shit; their tickers too). The first entry after
	## _ready is the first instance: its tickers were just activated.
	if _clips_entered:
		for t: Dictionary in _tickers:
			if t["active"] and _ticker_in_body(t):
				_restart_ticker(t)
	var info: Dictionary = {}   # node -> {bone, lib, entry}
	for bone_name: String in _bones:
		info[_bones[bone_name]] = {"bone": bone_name,
				"lib": _strip_lib_prefix(_bone_lib.get(bone_name, "")), "entry": {}}
	for entry: Dictionary in _nested:
		if not str(entry["bone_name"]).begins_with("@"):
			info[entry["node"]] = {"bone": entry["bone_name"], "lib": entry["library"],
					"entry": entry}
	var affected: Array = []
	for node in info:
		var has_ticker := false
		for t: Dictionary in _tickers:
			var target: Variant = t.get("target", null)
			if target is Dictionary and target["node"] == node:
				has_ticker = true
				break
		if _child_frames.has(node) or _graphic_shown.has(node) or has_ticker:
			affected.append(node)
	if affected.is_empty():
		return
	for node in affected:
		_drop_dynamic_ticker(node)
		_child_frames.erase(node)
		_graphic_shown.erase(node)
		var lib: String = info[node]["lib"]
		if _index_ticker_frame(lib) < 0:
			_lib_held_frame.erase(lib)
	# Bones first: their re-show recurses into the graphics nested in them.
	for node in affected:
		if not info[node]["entry"].is_empty():
			continue
		var r := {"node": node, "lib": info[node]["lib"], "entry": {}, "bone": info[node]["bone"]}
		_show_child_frame(r, _lib_current_frame(r["lib"]))
		_child_frames.erase(node)
	for node in affected:
		var entry: Dictionary = info[node]["entry"]
		if entry.is_empty() or _graphic_shown.has(node):
			continue   # a bone, or a graphic already re-derived above
		if entry.get("graphic", false):
			# A graphic's frame derives from its container's (Flash rule).
			_show_child_entry(entry, _container_frame_of(entry))
			continue
		var r := {"node": node, "lib": info[node]["lib"], "entry": entry, "bone": info[node]["bone"]}
		_show_child_frame(r, _lib_current_frame(r["lib"]))
		_child_frames.erase(node)
	# The re-shows held their frames (_show_child_frame); a fresh instance
	# holds nothing — the live rule (label variant, index ticker, subclass)
	# decides again.
	for node in affected:
		var lib: String = info[node]["lib"]
		if _index_ticker_frame(lib) < 0:
			_lib_held_frame.erase(lib)


func _on_animation_finished(anim_name: String) -> void:
	## Flash frame-script chaining: follow the animation's `next`.
	state_finished.emit(anim_name)
	var anim: Animation = _anim_player.get_animation(anim_name)
	if anim == null or not anim.has_meta("next"):
		return
	var next_info: Dictionary = anim.get_meta("next")
	if next_info.is_empty():
		return
	var next_name := str(next_info.get("animation", ""))
	var mode := str(next_info.get("mode", "play"))
	if next_name == "" or not _anim_player.has_animation(next_name):
		return
	_start_anim(next_name, 0, mode == "hold")
	anim_chained.emit(anim_name, next_name, mode)


func _apply_bone_order(anim_name: String) -> void:
	## Set the draw order of the bones for an animation: Flash draws the
	## depth list in order, and Godot's CanvasGroup does not isolate its
	## children's z_index, so the order is the sibling order under `body`
	## (index.json precomputed.bone_orders, back to front). Called from every
	## play()/seek() entry point and by the METHOD key at t=0 of each
	## animation (which does not fire on seek). No-op when already ordered.
	if _current_bone_order == anim_name:
		return
	var orders: Dictionary = _index.get("precomputed", {}).get("bone_orders", {})
	var order: Array = orders.get(anim_name, [])
	if order.is_empty():
		return
	var idx := 0
	for bone_name: String in order:
		var node: Node2D = _bones.get(bone_name)
		if node == null:
			continue
		if node.get_index() != idx:
			_body.move_child(node, idx)
		idx += 1
	_current_bone_order = anim_name


# =============================================================================
# Method-track targets
# =============================================================================

func _on_frame_label(label: String) -> void:
	## Called by method call tracks when an animation reaches a named frame label.
	frame_label_reached.emit(label)


func _on_frame_stop(frame: int) -> void:
	## Called by method call tracks on a frame that carries `stop()` in Flash.
	## The hold itself is encoded by the section boundaries / hold_last.
	frame_stop_reached.emit(frame)


func _nested_entries_for(path: Array, node: String) -> Array[Dictionary]:
	## The nested entries a compiled frame-script key addresses (`head.eye`,
	## `puha.puha`): resolved like the public child_goto() — from the bone
	## `node` (the path's first instance, as the compiler named it) down the
	## path by XFL instance name (_assign_instance_names; an unnamed child
	## matches by library), preferring the child present at its container's
	## current frame (_resolve_child_path). `puha.puha` is the instance
	## `puha` of library turel_puha1..10 on the frame puha shows. When the
	## instance path resolves nothing, the older rule applies: every child
	## whose library equals the last path element, under that bone.
	var result: Array[Dictionary] = []
	if path.is_empty():
		return result
	var bone := node if _bones.has(node) else ""
	if bone == "" and path.size() >= 1:
		bone = _bone_node_for_instance(str(path[0]))
	if bone != "" and path.size() >= 2:
		var head := {"node": _bones[bone], "lib": _strip_lib_prefix(_bone_lib.get(bone, "")),
				"entry": {}, "bone": bone}
		var r := _resolve_child_path(head, path, 1)
		if not r.is_empty() and not (r["entry"] as Dictionary).is_empty():
			result.append(r["entry"])
			return result
	var lib := str(path[path.size() - 1])
	for entry: Dictionary in _nested:
		if entry["library"] != lib:
			continue
		if bone != "" and entry["bone_name"] != bone:
			continue
		result.append(entry)
	return result


func _on_child_goto(path: Array, target: Variant, play: bool, node: String = "") -> void:
	## Method-track target for Flash frame scripts that navigate a nested clip
	## (`head.eye.gotoAndStop(2)`; args from manifest2tres: path, 0-based frame
	## or label, play flag, the bone node). Generic handling, shared with the
	## public child_goto()/child_play(): every addressed nested clip shows that
	## frame of its own symbol (keyframe artwork and the children it holds
	## there); a label resolves through the symbol's timeline labels; play
	## runs the clip's own timeline on from there (a per-node ticker).
	## Subclasses override for clips they know.
	for entry: Dictionary in _nested_entries_for(path, node):
		var r := {"node": entry["node"], "lib": entry["library"], "entry": entry,
				"bone": entry["bone_name"]}
		var frame := -1
		if target is int or target is float:
			frame = clampi(int(target), 0, _lib_total_frames(entry["library"]) - 1)
		else:
			frame = _child_frame_of(entry["library"], str(target))
		if frame < 0:
			continue
		if play:
			_child_play_resolved(r, frame)
		else:
			_drop_dynamic_ticker(entry["node"])
			_show_child_frame(r, frame)
	child_goto_reached.emit(path, target, play, node)


func _on_child_visible(path: Array, value: bool, node: String = "") -> void:
	## Method-track target for `<inst>...visible=true|false` frame scripts:
	## gates the addressed nested clips (kept across armour/library changes,
	## see _nested_should_show) and reports the change.
	for entry: Dictionary in _nested_entries_for(path, node):
		_child_hidden["%s/%s" % [entry["bone_name"], entry["library"]]] = not value
		_refresh_nested_entry(entry)
	child_visible_changed.emit(path, value, node)


func _on_frame_script(text: String) -> void:
	## Method-track target for a frame-script statement the compiler could not
	## classify (`head.morda.horn.filters=[]` ...): reported only.
	frame_script_reached.emit(text)


func set_mark_visible(is_visible: bool, bone_name: String = "") -> void:
	## Show/hide the cutie mark (Flash instance `mark`, library `quti`) under
	## one bone (`sleg1.mark.visible=false` targets the far hind leg) or under
	## every bone when bone_name == "". The state survives armour changes and
	## refreshes. Subclasses with their own rule override this.
	var mark_libs := _rig_mark_libraries()
	for entry: Dictionary in _nested:
		if not (entry["library"] in mark_libs):
			continue
		if bone_name != "" and entry["bone_name"] != bone_name:
			continue
		_child_hidden["%s/%s" % [entry["bone_name"], entry["library"]]] = not is_visible
		_refresh_nested_entry(entry)


func set_eye_state(_state: int) -> void:
	## Player-only: the player's `eye` clip (`eye.gotoAndStop`; player_rig.gd
	## overrides it). A no-op on generic rigs whose config routes `head.eye`
	## here (necrboss, rigs/necrboss.json:35-37: `body_derg`, `body_die`,
	## `body_die_jump` carry such keys), so their METHOD keys resolve
	## (Step 10.1, open item O2: the necrboss eye frame does not change).
	pass


func get_eye_state() -> int:
	## R3 #6 (Step 16.1): the eye state set_eye_state last applied (player_rig.gd
	## overrides it); 0 on generic rigs.
	return 0


func _child_goto(path: Array, target: Variant, play: bool, node: String = "") -> void:
	## Older method-key name; same contract as _on_child_goto.
	_on_child_goto(path, target, play, node)


# =============================================================================
# Helpers

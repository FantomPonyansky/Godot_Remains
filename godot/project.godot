; Engine configuration file.
; Godot 4.7 project — FoE: Remains port (vertical slice)

config_version=5

[application]

config/name="FoE Remains"
config/description="Godot 4 reimplementation of Fallout Equestria: Remains (playable vertical slice)."
config/version="0.1.0-slice"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

UserDir="*res://scripts/user_dir.gd"
GameState="*res://scripts/autoload/game_state.gd"
AudioManager="*res://scripts/autoload/audio_manager.gd"
SfxBank="*res://scripts/autoload/sfx_bank.gd"
Locale="*res://scripts/autoload/locale.gd"
Prompts="*res://scripts/autoload/prompts.gd"
UiNav="*res://scripts/autoload/ui_nav.gd"
InputBindings="*res://scripts/autoload/input_bindings.gd"
Sight="*res://scripts/autoload/sight.gd"
CameraDistance="*res://scripts/autoload/camera_distance.gd"
Autopick="*res://scripts/autoload/autopick.gd"
ControlsUI="*res://scripts/autoload/controls_ui.gd"
Progression="*res://scripts/autoload/progression.gd"
MagicBinds="*res://scripts/autoload/magic_binds.gd"
Inventory="*res://scripts/autoload/inventory.gd"
Condition="*res://scripts/autoload/condition.gd"
Effects="*res://scripts/autoload/effects.gd"
Craft="*res://scripts/autoload/craft.gd"
DebugConsole="*res://scripts/autoload/debug_console.gd"
WorldState="*res://scripts/autoload/world_state.gd"
Travel="*res://scripts/autoload/travel.gd"
Story="*res://scripts/autoload/story.gd"
ScriptsEngine="*res://scripts/autoload/scripts_engine.gd"
CamShake="*res://scripts/autoload/cam_shake.gd"
Pets="*res://scripts/autoload/pets.gd"
Favorites="*res://scripts/autoload/favorites.gd"
Vendors="*res://scripts/autoload/vendors.gd"
Stash="*res://scripts/autoload/stash.gd"

[debug]

file_logging/enable_file_logging.pc=true
file_logging/max_log_files=30

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom="res://theme/scroll.tres"


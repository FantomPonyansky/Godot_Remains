[layer_names]

2d_physics/layer_1="world"
2d_physics/layer_2="player"
2d_physics/layer_3="enemy"
2d_physics/layer_4="player_bullet"
2d_physics/layer_5="enemy_bullet"
2d_physics/layer_6="interactable"
2d_physics/layer_7="platforms"
2d_physics/layer_8="spell_wall"
2d_physics/layer_9="ghost_wall"

[foe]

art/load_on_demand=true

[physics]

common/physics_ticks_per_second=30
common/max_physics_steps_per_frame=4
common/physics_interpolation=true

[rendering]

textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.12, 0.14, 0.16, 1)
